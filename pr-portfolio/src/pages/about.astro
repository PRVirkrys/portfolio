---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Prefooter from '../components/Prefooter.astro';
import FlashPolaroids from '../components/about/FlashPolaroids.astro';
import Polaroid from '../components/about/Polaroid.astro';
import JourneyChapters from '../components/about/JourneyChapters.astro';
import SectionIntro from '../components/about/SectionIntro.astro';
import Tag from '../components/ui/Tag.astro';
import Highlight from '../components/ui/Highlight.astro';
import CaseCallout from '../components/case/CaseCallout.astro';
import LearningsGrid from '../components/case/LearningsGrid.astro';
import type { ImageMetadata } from 'astro';
import portrait from '../assets/about/paula.webp';
import thesisBook from '../assets/about/tfg-libro.jpg';
import flash01 from '../assets/about/flash/flash-01.jpg';
import flash02 from '../assets/about/flash/flash-02.jpg';
import flash03 from '../assets/about/flash/flash-03.jpg';
import flash04 from '../assets/about/flash/flash-04.jpg';
import flash05 from '../assets/about/flash/flash-05.jpg';

// Chapter photos live in one folder per chapter under assets/about. Listed
// files come first, in this order (the first is the top of the pile); any
// other image dropped in the folder joins after them in file-name order,
// with the album's fallback text.
type PhotoText = { alt: string; caption: string };
const photoFiles = import.meta.glob<{ default: ImageMetadata }>('../assets/about/*/*.{jpg,jpeg,png,webp}', { eager: true });
const album = (folder: string, described: Record<string, PhotoText>, fallback: PhotoText) => {
  const prefix = `../assets/about/${folder}/`;
  const files = Object.keys(photoFiles).filter(path => path.startsWith(prefix)).map(path => path.slice(prefix.length));
  const order = [...Object.keys(described).filter(file => files.includes(file)), ...files.filter(file => !(file in described)).sort((a, b) => a.localeCompare(b))];
  return order.map(file => ({ src: photoFiles[prefix + file].default, ...(described[file] ?? fallback) }));
};

const bmxPhotos = album('bmx', {
  'bmx-01.jpg': { alt: 'Podio del Campeonato Mundial de BMX 2001 en Louisville, Kentucky, con las corredoras sosteniendo sus trofeos.', caption: 'Louisville, 2001' },
  'bmx-02.jpg': { alt: 'Paula de niña, con el uniforme del Ecuador Racing Team, sonriendo en una calle de Louisville.', caption: 'Ecuador Racing Team' },
}, { alt: 'Paula en su etapa de BMX Supercross.', caption: 'BMX Supercross' });
const bigpromoPhotos = album('bigpromo', {
  'logo.png': { alt: 'Logotipo de BigPromo: un carrito de compras naranja junto a las palabras “Big Promo” y “ec.com”, sobre fondo negro.', caption: 'Mi primera startup' },
  'app.png': { alt: 'Maqueta de la app de BigPromo en un móvil, con categorías, ofertas destacadas y productos con etiqueta de descuento.', caption: 'Promos en el móvil' },
}, { alt: 'Imagen del proyecto BigPromo.', caption: 'BigPromo' });
const elisavaPhotos = album('elisava', {
  'logo.png': { alt: 'Logotipo de ELISAVA en negro sobre fondo claro.', caption: 'Barcelona, 2018' },
  'labar.png': { alt: 'Maqueta de LaBar en un móvil delante de una lavadora: una app con contador de monedas y recompensas.', caption: 'LaBar' },
  'sweepus.png': { alt: 'Maqueta de SweepUs en un móvil: una app con el plan semanal de comidas, con desayuno, comida y cena.', caption: 'SweepUs' },
}, { alt: 'Proyecto del máster en ELISAVA.', caption: 'ELISAVA' });
const lpaPhotos = album('lpa', {
  'logo.png': { alt: 'Logotipo de LPA en azul sobre fondo claro.', caption: 'Fintech B2B' },
}, { alt: 'Imagen de LPA.', caption: 'LPA' });
const failfastPhotos = album('failfast', {
  'logo.png': { alt: 'Logotipo de Fail Fast en blanco sobre fondo negro.', caption: 'Fail Fast' },
  'clients.png': { alt: 'Logotipos de clientes: FC Barcelona, base:, Sant Joan de Déu, La meva Salut, Time Chef y UOC.', caption: 'Un mundo por proyecto' },
}, { alt: 'Imagen de Fail Fast.', caption: 'Fail Fast' });
const pelt8Photos = album('pelt8', {
  'logo.png': { alt: 'Isotipo de Pelt8: un octógono turquesa sobre fondo azul marino.', caption: 'Reporting ESG' },
}, { alt: 'Imagen de Pelt8.', caption: 'Pelt8' });
const fullStackPhotos = album('full-stack', {
  'frontend.png': { alt: 'Logotipos de HTML5, CSS3, JavaScript, TypeScript, Sass y Angular.', caption: 'Frontend' },
  'backend.png': { alt: 'Logotipos de Java, Spring Boot, MySQL, MongoDB y REST API.', caption: 'Backend' },
}, { alt: 'Tecnologías del máster Full Stack.', caption: 'Full Stack' });

const principles = [
  { title: 'Comprender', body: 'Investigo a las personas, el contexto, el negocio, la información, las restricciones y las preguntas todavía abiertas. Antes de simplificar algo, necesito comprender qué complejidad es necesaria y cuál podemos eliminar.' },
  { title: 'Conectar', body: 'Busco relaciones y patrones hasta encontrar una estructura que permita conversar y decidir. La claridad visual no es el punto de partida: es la consecuencia de haber entendido mejor el problema.' },
  { title: 'Dar forma', body: 'Utilizo research, arquitectura de información, flujos, sistemas y prototipos para convertir una intención en algo que el equipo pueda observar, discutir y validar.' },
  { title: 'Construir y aprender', body: 'Cuando aporta claridad, utilizo frontend, Framer, no-code, automatización o IA para probar una solución. Construir hace visibles nuevas restricciones y preguntas; esas respuestas vuelven a alimentar el diseño.' },
];

// A personal prologue, studies and work on one timeline, oldest first.
const journey = [
  {
    start: 2001, end: 2001, kind: 'personal' as const, place: 'Louisville, EE. UU.', name: 'BMX Supercross', title: 'Ecuador Racing Team',
    tagline: 'Algo que me formó mucho antes de saberlo.',
    body: [
      'El bicicrós fue una de las primeras experiencias que me enseñó de qué era capaz cuando perseveraba. En 2001 quedé <strong>primera en el premundial y séptima del mundo</strong> en BMX Supercross, en Louisville, Kentucky.',
      'Me enseñó que caerse forma parte del recorrido y que avanzar consiste en entrenar, observar, ajustar y volver a intentarlo. También me dejó el gusto por esa mezcla de concentración, vértigo y satisfacción que aparece cuando todo el trabajo previo desemboca en una carrera a toda velocidad.',
      'Muchos años después sigo reconociendo esa forma de aprender en mí: insistir, prestar atención a lo que no funcionó y regresar al siguiente intento con algo nuevo.',
    ],
    photos: bmxPhotos,
  },
  {
    start: 2010, end: 2015, kind: 'study' as const, place: 'Cuenca, Ecuador', name: 'Universidad del Azuay', title: 'Diseño Gráfico',
    tagline: 'Elegí empezar por el porqué.',
    body: [
      'Cuando llegó el momento de escoger una carrera, dudé entre diseño y código. Me apasionaban los dos por la misma razón: su capacidad de convertir una idea en algo real.',
      'El código podía enseñarme <strong>cómo construirla</strong>. Pero entendí que el diseño podía ayudarme a descubrir <strong>qué merecía la pena construir, para quién y con qué propósito</strong>. Por eso decidí empezar por allí: por el origen de la idea, por el porqué y por las decisiones que le dan dirección.',
      'La formación en Diseño Gráfico me enseñó a conceptualizar antes de ejecutar, construir significado y tomar decisiones visuales con intención. Esa base sigue presente cuando organizo información, defino jerarquías o construyo un sistema visual.',
    ],
    tags: ['Diseño gráfico', 'Identidad', 'Comunicación visual', 'Conceptualización', 'Dirección de arte'],
  },
  {
    start: 2015, end: 2015, kind: 'study' as const, place: 'Cuenca, Ecuador', name: 'Trabajo de graduación', title: 'Experiencia de compra en negocios locales',
    tagline: 'Mi primera investigación nació de una necesidad que tenía muy cerca.',
    body: [
      'Un año antes había escuchado por primera vez el término <strong>experiencia de usuario</strong>. Me cautivó porque describía una idea que empezaba a interesarme cada vez más: el diseño no solo podía comunicar algo; también podía transformar la manera en que una persona comprendía, elegía y vivía una experiencia.',
      'Mi madre tenía un establecimiento local de comida y, a través de ella, conocía a muchas personas que intentaban sacar adelante sus propios negocios. Veía cómo competían con cadenas transnacionales que disponían de más recursos, visibilidad y sistemas de marca. Cuando en la universidad nos plantearon el trabajo de graduación como una oportunidad para generar impacto social, supe dónde quería empezar.',
      'Mi tesis, <strong>“Diseño de estrategias gráficas para mejorar la experiencia de compra de comida”</strong>, investigó cómo el diseño podía ayudar a que pequeños negocios de alimentación fueran más competitivos. El proyecto propuso estrategias emergentes de imagen con criterios de sostenibilidad y las aplicó en elementos físicos y digitales de tres establecimientos.',
      'Fue una de mis primeras experiencias utilizando investigación, contexto, estrategia y diseño como partes de una misma respuesta. Ya no se trataba únicamente de crear una identidad visual, sino de comprender el recorrido de compra, detectar oportunidades y diseñar una experiencia capaz de ayudar a un negocio real.',
      'El proyecto fue seleccionado para ser presentado en el <strong>III Concurso de Reconocimiento a la Investigación Universitaria Estudiantil de SENESCYT</strong>. Años después, la Universidad del Azuay lo convirtió en una publicación, ampliando aquel trabajo académico hacia una herramienta que otras personas pudieran consultar y utilizar.',
    ],
    tags: ['Investigación', 'Experiencia de usuario', 'Experiencia de compra', 'Negocio local', 'Estrategia gráfica', 'Competitividad', 'Sostenibilidad', 'Impacto social'],
    links: [
      { label: 'Trabajo de graduación · Repositorio UDA', href: 'https://dspace.uazuay.edu.ec/handle/datos/4784' },
      { label: 'Libro · Casa Editora UDA', href: 'https://publicaciones.uazuay.edu.ec/index.php/ceuazuay/catalog/book/28' },
      { label: 'Libro · Digitalia', href: 'https://www.digitaliapublishing.com/a/133399/estrategias-graficas-para-mejorar-la-experiencia-de-compra-de-comida' },
    ],
    photos: [{ src: thesisBook, alt: 'Portada roja del libro “Diseño de estrategias gráficas para mejorar la experiencia de compra de comida”, con la ilustración de una tostadora, Universidad del Azuay, 2015.', caption: 'De tesis a libro' }],
  },
  {
    start: 2016, end: 2018, place: 'Cuenca, Ecuador', name: 'BigPromo', title: 'Fundadora & Product/Web Designer',
    tagline: 'Mi primera idea tuvo que enfrentarse al mundo real.',
    body: [
      'Fundé BigPromo, una plataforma digital de promociones en Ecuador. Definí la propuesta de valor, diseñé la experiencia web y móvil, construí la plataforma en WordPress con modificaciones en PHP, desarrollé la identidad y trabajé en su lanzamiento.',
      'Fue la primera vez que conecté personas, negocio, producto, tecnología y comunicación alrededor de una misma idea. También entendí que diseñar un producto no termina cuando la interfaz se ve bien: tiene que funcionar, poder explicarse y encontrar su lugar.',
    ],
    tags: ['Fundadora', 'Propuesta de valor', 'Web y móvil', 'WordPress + PHP', 'Identidad', 'Lanzamiento'],
    photos: bigpromoPhotos,
  },
  {
    start: 2018, end: 2019, kind: 'study' as const, place: 'Barcelona, España', name: 'ELISAVA', title: 'Máster en Diseño y Dirección de Proyectos para Internet',
    tagline: 'La curiosidad me llevó al otro lado del mundo.',
    body: [
      'Las ganas de profundizar en experiencia de usuario y comprender mejor cómo se conciben los productos digitales me hicieron cruzar el Atlántico: dejé Ecuador y me trasladé a Barcelona para estudiar en ELISAVA.',
      'Allí amplié mi formación visual hacia UX, estrategia y dirección de proyectos. El diseño empezó a ocupar un espacio más amplio: no solo como una forma de comunicar, sino como una manera de investigar, tomar decisiones y dirigir la construcción de una experiencia digital.',
    ],
    tags: ['Product Design', 'UX', 'Estrategia digital', 'Dirección de proyectos', 'Barcelona'],
    photos: elisavaPhotos,
  },
  {
    start: 2018, end: 2020, place: 'Barcelona, España', name: 'LPA', title: 'UX/UI Designer & Front-end Developer', workCompany: 'lpa' as const,
    tagline: 'El código se convirtió en otra herramienta de diseño.',
    body: [
      'Trabajé con productos fintech B2B: dashboards, tablas, árboles y flujos con una gran densidad de información. Además de diseñarlos, implementaba interfaces con HTML, CSS y Sass dentro de Angular.',
      'Empecé a asumir historias de usuario completas y a elegir entre Figma y código según lo que necesitaba comprobar. Entender la implementación me ayudó a detectar restricciones antes, conversar mejor con ingeniería y diseñar soluciones más realistas.',
    ],
    tags: ['Fintech B2B', 'Datos complejos', 'HTML', 'CSS', 'Sass', 'Angular', 'Colaboración con ingeniería'],
    photos: lpaPhotos,
  },
  {
    start: 2021, end: 2023, place: 'Barcelona, España', name: 'Fail Fast', title: 'UX/UI Designer', workCompany: 'failfast' as const,
    tagline: 'Descubrí cuánto me motiva entrar en mundos que todavía no conozco.',
    body: [
      'Trabajé en ámbitos tan diferentes como salud, educación, deporte y servicios corporativos. Cada proyecto empezaba con un nuevo lenguaje, nuevas reglas y personas con necesidades distintas.',
      'Esa incertidumbre no me frenaba: despertaba mi curiosidad. Disfrutaba investigando, haciendo preguntas y encontrando los patrones que me permitían convertir un dominio desconocido en una arquitectura, un flujo o una experiencia que el equipo pudiera entender y construir.',
    ],
    tags: ['Salud', 'Educación', 'Deporte', 'Research', 'Arquitectura de información', 'Facilitación', 'Prototipado'],
    photos: failfastPhotos,
  },
  {
    start: 2023, end: 2025, place: 'Barcelona, España · Remoto', name: 'Pelt8', title: 'Lead Product Designer', workCompany: 'pelt8' as const,
    tagline: 'Todas las capas empezaron a trabajar juntas.',
    body: [
      'Como Lead Product Designer y única diseñadora del equipo, lideré el diseño end-to-end de un producto B2B SaaS de reporting ESG utilizado por más de 25 empresas. Diseñé y mantuve su sistema de diseño y trabajé directamente con producto, negocio e ingeniería.',
      'También intervine en componentes React, construí la web en Framer y creé soluciones con Tally y Make para lanzar iniciativas sin añadir dependencia al roadmap de ingeniería.',
      'Mi aportación no consistía en utilizar muchas herramientas. Consistía en detectar qué impedía avanzar, conectar las piezas y elegir la forma más útil de resolverlo.',
    ],
    tags: ['B2B SaaS', 'ESG', '+25 empresas', 'Design system', 'React', 'Framer', 'Tally + Make', 'Liderazgo'],
    photos: pelt8Photos,
  },
  {
    start: 2025, status: 'En curso', kind: 'study' as const, place: 'Barcelona, España', name: 'Full Stack, IA y proyectos propios', title: 'Máster en Full Stack Development · Grupo Atrium', workCompany: 'pr' as const,
    tagline: 'Sigo ampliando lo que puedo comprender y construir.',
    body: [
      'Curso un Máster en Full Stack Development para profundizar en lo que ocurre más allá de la interfaz: frontend, backend, APIs y datos.',
      'En proyectos propios como <strong>MedusaWatch</strong> y <strong>Mundial Predictions</strong> puedo recorrer el camino completo, desde una pregunta inicial hasta la lógica, la información, la interfaz y una solución funcional. Construir me ayuda a descubrir restricciones, validar antes y volver a diseñar con más información.',
    ],
    tags: ['Java', 'Spring Boot', 'Angular', 'TypeScript', 'APIs REST', 'MySQL', 'MongoDB', 'IA aplicada', 'Prototipado funcional'],
    photos: fullStackPhotos,
  },
];

// First item is the top of the pile.
const flashPhotos = [
  { src: flash05, alt: 'Flash sentado en la arena de la playa, con arnés amarillo, mirando a cámara.', caption: 'Flash, jefe de pausas' },
  { src: flash02, alt: 'Flash saltando en la playa para atrapar una pelota rosa.', caption: 'Modo paseo activado' },
  { src: flash04, alt: 'Flash dormido junto a un portátil con código abierto en pantalla.', caption: '“Solo un momento”' },
  { src: flash03, alt: 'Flash sentado en el suelo de madera de casa, con las orejas levantadas.', caption: '¿Salimos ya?' },
  { src: flash01, alt: 'Paula abrazando a Flash en casa.', caption: 'Mi compañero' },
];
---

<!doctype html>
<html lang="es" class="dark">
  <head><BaseHead title="About · Paula Rodas" description="Senior Product Designer con un perfil híbrido entre Product Design y UX Engineering. Diseño para dar dirección a las ideas; construyo para acercarlas a la realidad." /></head>
  <body>
    <Header />
    <main class="about">
      <header class="about-hero">
        <div class="about-hero__intro">
          <Tag category="Neutral">About me</Tag>
          {/* The two verbs get a highlighter swipe; the code brackets are
              decoration, so screen readers just hear "Construyo". */}
          <h1><Highlight tone="cool" delay={300}>Diseño</Highlight> para dar dirección a las ideas. <Highlight tone="warm" delay={650}><span aria-hidden="true">&lt;</span>Construyo<span aria-hidden="true">/&gt;</span></Highlight> para acercarlas a la realidad.</h1>
          <p class="about-lead">Hola, soy Paula Rodas, Senior Product Designer con más de nueve años de experiencia y un perfil híbrido entre Product Design y UX Engineering.</p>
        </div>
        <div class="about-hero__photo">
          <Polaroid src={portrait} alt="Retrato en blanco y negro de Paula Rodas, con el pelo rizado y gafas, mirando a cámara." caption="Paula Rodas" tilt={3} widths={[480, 800, 979]} sizes="(max-width: 960px) 90vw, 40vw" loading="eager" fetchpriority="high" />
        </div>
        <div class="about-hero__body">
          <div class="about-prose">
            <p>Me enamoré del diseño cuando descubrí que una idea podía dejar de ser algo abstracto y convertirse en una experiencia que otras personas pudieran ver, entender y utilizar. Años después, el código me acercó todavía más a la posibilidad de materializar esas ideas en el mundo digital: aquel momento en el que una decisión deja de existir solamente en un archivo de diseño y empieza a comportarse como un producto real.</p>
            <p>La curiosidad ha sido el motor de mi recorrido. Me ha llevado a querer comprender cómo se construyen las cosas, qué necesita cada idea para avanzar y qué tengo que aprender para hacerla realidad.</p>
          </div>
        </div>
      </header>

      <section class="about-career" aria-labelledby="journey-title">
        <JourneyChapters chapters={journey} eyebrow="Mi recorrido" heading="Los caminos cambiaron." headingMuted="La curiosidad se quedó." intro="No llegué hasta aquí siguiendo un plan cerrado. Cada vez que una idea o un proyecto me pedía comprender algo nuevo, aprendí una forma distinta de observar, diseñar o construir. Estas son las etapas que fueron dando forma a mi manera de trabajar." headingId="journey-title" />
      </section>

      <section class="about-section" aria-labelledby="process-title">
        <div class="about-section__head"><SectionIntro size="sm" eyebrow="Mi forma de trabajar" heading="Comprender antes de dar forma." headingMuted="Construir para volver a preguntar." lede="No empiezo por una pantalla ni por una herramienta. Empiezo intentando comprender qué ocurre, quién está implicado y qué necesita el equipo para tomar una mejor decisión." headingId="process-title" /></div>
        <div class="about-section__content">
          <LearningsGrid>
            {principles.map(principle => <CaseCallout size="lg" title={principle.title} body={principle.body} />)}
          </LearningsGrid>
        </div>
      </section>

      <section class="about-section" aria-labelledby="ai-title">
        <div class="about-section__head"><SectionIntro size="sm" eyebrow="Nuevas capacidades" heading="La IA ha multiplicado" headingMuted="lo que puedo explorar y construir." headingId="ai-title" /></div>
        <div class="about-section__content about-prose">
          <p>La utilizo para acelerar research y síntesis, detectar patrones, explorar alternativas, documentar decisiones y transformar ideas en prototipos funcionales para testing. También me ayuda a programar, depurar y refactorizar cuando necesito acercar una propuesta a un comportamiento real.</p>
          <p>A veces se siente como haber ganado nuevos superpoderes: puedo recorrer más rápido la distancia entre una pregunta y algo que el equipo puede observar, probar y discutir.</p>
          <p>Pero un superpoder no decide por sí solo dónde merece la pena utilizarlo. La IA puede generar muchas respuestas; no puede comprender por sí sola qué necesita una persona, qué consecuencias tendrá una decisión ni qué posibilidad tiene sentido para el producto.</p>
          <p>Cuando crear se vuelve más rápido, <strong>el criterio importa todavía más</strong>. Mi responsabilidad sigue siendo formular la pregunta, dirigir la exploración y decidir qué merece avanzar.</p>
          <blockquote class="about-quote">La IA amplía mi capacidad para explorar y construir. El diseño sigue dando dirección a lo que decido hacer posible.</blockquote>
        </div>
      </section>

      <section class="about-section about-flash" aria-labelledby="flash-title">
        <div class="about-flash__copy">
          <SectionIntro size="sm" eyebrow="Fuera de la pantalla" heading="Flash me recuerda que tomar distancia" headingMuted="también forma parte del proceso." headingId="flash-title" />
          <div class="about-prose">
            <p>Flash es mi perro, mi compañero y quien se ocupa de que cierre el ordenador de vez en cuando.</p>
            <p>Salir a caminar me ayuda a ordenar ideas y volver con otra perspectiva. Aunque él ya conoce la otra cara de la historia: a veces se me ocurre algo a mitad del paseo y regresamos antes porque necesito comprobar si funciona. Él preferiría seguir caminando; yo prometo abrir el portátil “solo un momento”.</p>
          </div>
        </div>
        <FlashPolaroids photos={flashPhotos} label="Fotos de Flash" />
      </section>

      <section class="about-section" aria-labelledby="now-title">
        <div class="about-section__head"><SectionIntro size="sm" eyebrow="Lo que viene" heading="Quiero seguir trabajando donde producto," headingMuted="sistemas e ingeniería se encuentran." headingId="now-title" /></div>
        <div class="about-section__content about-prose">
          <p>Hoy profundizo en desarrollo full stack y continúo explorando cómo la IA puede <strong>ampliar el espacio entre imaginar, diseñar y construir</strong>.</p>
          <p>Me interesan especialmente los productos B2B, los sistemas o datos complejos, los equipos que integran diseño e ingeniería desde el principio y los retos en los que hace falta combinar una visión de conjunto con atención al detalle.</p>
          <p>Si estás construyendo un producto complejo, evolucionando un sistema de diseño o buscando acercar diseño e ingeniería, me encantará conocer el reto.</p>
        </div>
      </section>
    </main>
    <Prefooter />
    <Footer />
  </body>
</html>

<style>
  /* Same outer column as /work (.work-page) so the page lines up with the prefooter. */
  .about { box-sizing: border-box; width: 100%; max-width: calc(1616px * var(--ui-scale)); margin-inline: auto; padding: calc(var(--component-header-height-desktop) + var(--space-12)) var(--gutter-desktop) var(--space-16); }

  /* ── Hero ── */
  /* Intro + body on the left, portrait spanning both rows on the right. */
  .about-hero { display: grid; grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); column-gap: calc(96px * var(--ui-scale)); row-gap: var(--space-16); align-items: start; padding-bottom: var(--space-24); }
  .about-hero__intro { display: grid; justify-items: start; gap: var(--space-8); }
  .about-hero__photo { grid-column: 2; grid-row: 1 / span 2; width: min(100%, calc(520px * var(--ui-scale))); justify-self: center; margin-top: var(--space-8); }
  h1 { max-width: 20ch; margin: 0; font-family: var(--font-heading); font-size: clamp(calc(48px * var(--ui-scale)), 5vw, calc(80px * var(--ui-scale))); font-weight: 700; line-height: 1.05; letter-spacing: -0.035em; }
  .about-hero__body { grid-column: 1; }
  .about-lead { margin: 0; font-family: var(--font-heading); font-size: calc(28px * var(--ui-scale)); font-weight: 500; line-height: 1.35; letter-spacing: -0.01em; color: var(--color-text); }

  /* ── Long-form copy: same reading treatment as CaseSection paragraphs ── */
  .about-prose { max-width: calc(820px * var(--ui-scale)); }
