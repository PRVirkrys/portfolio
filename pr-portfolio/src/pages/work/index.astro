---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Prefooter from '../../components/Prefooter.astro';
import Button from '../../components/ui/Button.astro';
import CaseStudyCard from '../../components/case/CaseStudyCard.astro';
import { workCompanies } from '../../data/work-companies';
import { caseFocus, focusCategories } from '../../lib/work-filters';
import { withBase } from '../../lib/url';
import { LayoutGrid, Rows3 } from '@lucide/astro';

const cases = (await getCollection('blog', ({ data }) => data.type === 'case-study')).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const companies = workCompanies.filter(company => cases.some(entry => entry.data.company === company.id));
const focuses = focusCategories.filter(focus => cases.some(entry => caseFocus(entry.data).includes(focus)));
---

<!doctype html>
<html lang="es" class="dark">
  <head><BaseHead title="Work · Paula Rodas" description="Case studies de producto, experiencia y diseño. Explora mi trabajo por empresa y disciplina." /></head>
  <body>
    <Header />
    <main class="work-page" data-work-page>
      <header class="work-page__intro">
        <h1>Work</h1>
        <p>Case studies de producto, experiencia y diseño.</p>
      </header>
      <div class="work-filters" data-work-filters hidden>
        <fieldset><legend>Dónde trabajé</legend><div class="work-filters__options">
          <button type="button" data-filter="company" data-value="" aria-pressed="true">Todos</button>
          {companies.map(company => <button type="button" data-filter="company" data-value={company.id} aria-pressed="false">{company.name}</button>)}
        </div></fieldset>
        <fieldset><legend>Foco</legend><div class="work-filters__options">
          <button type="button" data-filter="focus" data-value="" aria-pressed="true">Todos</button>
          {focuses.map(focus => <button type="button" data-filter="focus" data-value={focus} aria-pressed="false">{focus}</button>)}
        </div></fieldset>
      </div>
      <noscript><p>Puedes explorar todos los casos. Activa JavaScript para usar los filtros.</p></noscript>
      <div class="work-page__results"><p data-work-count role="status" aria-live="polite">{cases.length} case studies</p><button type="button" class="work-page__clear" data-clear-filters hidden>Limpiar filtros</button><div class="work-view" role="group" aria-label="Vista" data-work-view><button type="button" data-view-option="grid" aria-pressed="true" aria-label="Cuadrícula"><LayoutGrid aria-hidden="true" /></button><button type="button" data-view-option="rows" aria-pressed="false" aria-label="Filas"><Rows3 aria-hidden="true" /></button></div></div>
      <div class="work-grid" data-work-grid data-view="grid">{cases.map((entry, index) => <CaseStudyCard entry={entry} eager={index < 2} />)}</div>
      {/* Restore the saved view before first paint so rows don't flash as a grid. */}
      <script is:inline>try { if (localStorage.getItem('work-view') === 'rows') document.querySelector('[data-work-grid]').dataset.view = 'rows'; } catch {}</script>
      <section class="work-empty" data-work-empty hidden aria-labelledby="empty-title"><h2 id="empty-title">No hay casos con esta selección</h2><p>Prueba otro foco o vuelve a explorar todos los proyectos.</p><Button data-clear-filters showLeadingIcon={false}>Ver todos los casos</Button></section>
    </main>
    <Prefooter />
    <Footer />
  </body>
</html>

<script>
  import '../../components/work/work-filter-controller';

  // Grid / rows view toggle (desktop only — mobile is always one column).
  const grid = document.querySelector<HTMLElement>('[data-work-grid]');
  const options = document.querySelectorAll<HTMLButtonElement>('[data-view-option]');
  const syncPressed = () => {
    for (const option of options) option.setAttribute('aria-pressed', String(option.dataset.viewOption === grid?.dataset.view));
  };
  syncPressed();
  for (const option of options) {
    option.addEventListener('click', () => {
      if (!grid || !option.dataset.viewOption) return;
      grid.dataset.view = option.dataset.viewOption;
      syncPressed();
      try { localStorage.setItem('work-view', option.dataset.viewOption); } catch {}
    });
  }
</script>

<style>
  .work-page { box-sizing: border-box; width: 100%; max-width: calc(1616px * var(--ui-scale)); margin-inline: auto; padding: calc(var(--component-header-height-desktop) + var(--space-12)) var(--gutter-desktop) var(--space-12); }
  .work-page__intro { margin-bottom: var(--space-8); }
  h1 { font-family: var(--font-heading); font-size: calc(72px * var(--ui-scale)); line-height: 1.1; font-weight: 700; letter-spacing: -1.5px; margin: 0 0 var(--space-3); }
  .work-page__intro p { color: var(--color-text-secondary); font-size: calc(24px * var(--ui-scale)); line-height: 1.5; letter-spacing: 0; margin: 0; }
  .work-filters { display: flex; flex-wrap: wrap; gap: var(--space-8); padding-bottom: var(--space-6); border-bottom: var(--border-width) solid var(--color-border); }
  [hidden] { display: none !important; }
  fieldset { border: 0; padding: 0; margin: 0; min-width: 0; }
  legend { text-transform: uppercase; font-size: calc(11px * var(--ui-scale)); font-weight: 700; letter-spacing: calc(2px * var(--ui-scale)); color: var(--color-text-muted); margin-bottom: var(--space-3); }
  .work-filters__options { display: flex; flex-wrap: wrap; gap: var(--space-3); }
  .work-filters button { padding: var(--space-3) var(--space-4); min-height: 36px; border: var(--border-width) solid var(--color-border-strong); border-radius: var(--radius-lg); background: transparent; color: var(--color-text); font-family: var(--font-sans); font-size: calc(14px * var(--ui-scale)); font-weight: 600; cursor: pointer; }
  .work-filters button:hover { background: var(--color-action-secondary-bg-hover); }
  .work-filters button[aria-pressed='true'] { background: var(--color-brand-purple-700); border-color: var(--color-brand-purple-700); color: var(--color-base-white); }
  button:focus-visible { outline: var(--focus-width) solid var(--color-focus); outline-offset: var(--space-1); }
  .work-page__results { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: var(--space-3); margin-block: var(--space-6); }
  .work-page__results p { margin: 0; font-size: calc(16px * var(--ui-scale)); letter-spacing: 0; color: var(--color-text-muted); }
  .work-page__clear { background: transparent; border: 0; padding: var(--space-2); color: var(--color-action-ghost-text); font: inherit; font-size: calc(16px * var(--ui-scale)); text-decoration: underline; cursor: pointer; }
  .work-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--space-8); }
  .work-grid[data-view='rows'] { grid-template-columns: minmax(0, 1fr); }
  .work-view { display: flex; gap: var(--space-1); margin-left: auto; padding: var(--space-1); border: var(--border-width) solid var(--color-border-strong); border-radius: var(--radius-lg); }
  .work-view button { display: grid; place-items: center; width: calc(40px * var(--ui-scale)); height: calc(40px * var(--ui-scale)); border: 0; border-radius: var(--radius-md); background: transparent; color: var(--color-text-secondary); cursor: pointer; }
  .work-view button:hover { background: var(--color-action-secondary-bg-hover); }
  .work-view button[aria-pressed='true'] { background: var(--color-brand-purple-700); color: var(--color-base-white); }
  .work-view :global(svg) { width: var(--icon-sm); height: var(--icon-sm); }
  .work-empty { padding: var(--space-16) var(--space-6); text-align: center; border: var(--border-width) solid var(--color-border); border-radius: var(--radius-lg); }
  .work-empty h2 { font-family: var(--font-heading); font-size: calc(28px * var(--ui-scale)); line-height: 1.3; letter-spacing: 0; margin: 0; }
  .work-empty p { color: var(--color-text-secondary); font-size: calc(18px * var(--ui-scale)); letter-spacing: 0; }
  @media (max-width: 839px) { .work-view { display: none; } .work-grid[data-view] { grid-template-columns: minmax(0, 1fr); } .work-page { padding: calc(var(--component-header-height-mobile) + var(--space-8)) var(--gutter-mobile) var(--space-12); } h1 { font-size: calc(56px * var(--ui-scale)); } .work-grid { grid-template-columns: minmax(0, 1fr); gap: var(--space-6); } }
</style>
