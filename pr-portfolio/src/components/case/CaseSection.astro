---
import Tag from '../ui/Tag.astro';
import type { TagCategory } from '../../data/work-navigation';

export interface Props {
	variant?: 'default' | 'subtle';
	layout?: 'side' | 'stacked' | 'text-only';
	tag?: string;
	tagCategory?: TagCategory;
	heading?: string;
	wide?: boolean;
	/** Assets width in 'stacked' layout (Figma node 16071:69248 — "Assets
	 * container" can span the full section or match the copy column).
	 * 'auto' (default) keeps the existing rule: a single image is contained
	 * to the copy width, multiple images span the full width. Set explicitly
	 * to override that guess either way. Ignored by 'side' and 'text-only'. */
	imageWidth?: 'auto' | 'contained' | 'full';
}

const {
	variant = 'default',
	layout = 'stacked',
	tag,
	tagCategory = 'Neutral',
	heading,
	wide = false,
	imageWidth = 'auto',
} = Astro.props;

const hasImage = Astro.slots.has('image');
// Anchor target for CaseSectionNav (and shareable deep links).
const id = heading
	?.normalize('NFD')
	.replace(/[\u0300-\u036f]/g, '')
	.toLowerCase()
	.replace(/[^a-z0-9]+/g, '-')
	.replace(/^-|-$/g, '');
---

<section
	class="cs-section"
	id={id || undefined}
	data-variant={variant}
	data-layout={layout}
	data-wide={wide || undefined}
>
	<div class="cs-section__inner">
		{hasImage && (
			<div class="cs-section__assets" data-image-width={imageWidth}>
				<slot name="image" />
			</div>
		)}
		<div class="cs-section__copy">
			{(tag || heading) && (
				<div class="cs-section__header">
					{tag && <Tag category={tagCategory}>{tag}</Tag>}
					{heading && <h2 class="cs-section__heading">{heading}</h2>}
				</div>
			)}
			<slot />
		</div>
	</div>
</section>

<style>
	.cs-section {
		/* Counter reset lives on .cs-article (CaseStudy.astro). */
		counter-increment: case-section;
		padding-block: calc(152px * var(--ui-scale));
	}
	.cs-section[data-variant='subtle'] {
		background-color: var(--color-bg-subtle);
	}
	.cs-section__inner {
		box-sizing: border-box;
		width: 100%;
		max-width: calc(1440px * var(--ui-scale));
		margin-inline: auto;
		padding-inline: calc(64px * var(--ui-scale));
		position: relative;
	}

	/* ── Stacked: assets on top, copy centred below ── */
	.cs-section[data-layout='stacked'] .cs-section__inner {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: calc(64px * var(--ui-scale));
	}
	.cs-section[data-layout='stacked'] .cs-section__assets {
		display: flex;
		gap: calc(24px * var(--ui-scale));
		width: 100%;
		justify-content: center;
	}
	/* A tall/portrait screenshot scaled to the column's width can end up
	   absurdly long (a 960×1637 diagram at the 680px column width renders
	   ~1000px tall). Cap the height instead and let width follow — the
	   image renders narrower than the column here, which is the accepted
	   tradeoff, and the lightbox is what gives full detail on click anyway. */
	.cs-section[data-layout='stacked'] .cs-section__assets :global(img) {
		/* 562.5px * 0.8 = 450px real. */
		max-height: calc(562.5px * var(--ui-scale));
		width: auto;
		height: auto;
	}
	/* Asset width variants only matter while stacked is a centred column
	   (≤960px); on desktop assets fill the right grid column. */
	@media (max-width: 960px) {
		/* 'auto': a single image doesn't span the full row — it matches the copy
		   column width below it. Explicit 'contained'/'full' below always win
		   over this guess. */
		.cs-section[data-layout='stacked'] .cs-section__assets[data-image-width='auto']:has(> :only-child) {
			width: min(calc(680px * var(--ui-scale)), 100%);
			margin-inline: auto;
		}
		.cs-section[data-layout='stacked'] .cs-section__assets[data-image-width='contained'] {
			width: min(calc(680px * var(--ui-scale)), 100%);
			margin-inline: auto;
		}
		.cs-section[data-layout='stacked'] .cs-section__assets[data-image-width='full'] {
			width: min(calc(1280px * var(--ui-scale)), 100%);
			margin-inline: auto;
		}
	}
	.cs-section[data-layout='stacked'] .cs-section__copy {
		width: min(calc(680px * var(--ui-scale)), 100%);
	}
	.cs-section[data-layout='stacked'][data-wide] .cs-section__copy {
		width: min(calc(1120px * var(--ui-scale)), 100%);
	}

	/* ── Side: image left, copy right ── */
	.cs-section[data-layout='side'] .cs-section__inner {
		display: flex;
		flex-direction: row;
		align-items: flex-start;
		justify-content: center;
		gap: calc(64px * var(--ui-scale));
	}
	.cs-section[data-layout='side'] .cs-section__assets {
		flex: 1;
		min-width: 0;
		align-self: stretch;
		position: relative;
	}
	.cs-section[data-layout='side'] .cs-section__copy {
		flex: 0 0 min(calc(680px * var(--ui-scale)), 50%);
	}
	/* ── Text only: just copy, centred ── */
	.cs-section[data-layout='text-only'] .cs-section__inner {
		display: flex;
		flex-direction: column;
		align-items: center;
	}
	.cs-section[data-layout='text-only'] .cs-section__copy {
		width: min(calc(680px * var(--ui-scale)), 100%);
	}
	.cs-section[data-layout='text-only'][data-wide] .cs-section__copy {
		width: min(calc(1120px * var(--ui-scale)), 100%);
	}

	/* ── Copy content ── */
	.cs-section__header {
		display: flex;
		flex-direction: column;
		/* Without this, column-flex's default align-items: stretch forces the
		   tag (a flex item here) to the container's full width instead of
		   hugging its label. */
		align-items: flex-start;
		gap: calc(16px * var(--ui-scale));
		margin-bottom: calc(16px * var(--ui-scale));
	}
	/* Chapter number (01, 02…) above the tag. */
	.cs-section__header::before {
		content: counter(case-section, decimal-leading-zero);
		font-family: var(--font-heading);
		font-size: calc(72px * var(--ui-scale));
		font-weight: 700;
		line-height: 0.85;
		letter-spacing: -0.05em;
		color: var(--color-action-ghost-text);
	}
	.cs-section__heading {
		max-width: 17ch;
		font-family: var(--font-heading);
		font-size: clamp(calc(38px * var(--ui-scale)), 3.5vw, calc(56px * var(--ui-scale)));
		font-weight: 700;
		line-height: 1.08;
		letter-spacing: -0.035em;
		color: var(--color-text);
		margin: 0;
	}

	/* Slot typography — applied via :global() since MDX renders into slots */
	.cs-section__copy :global(p) {
		font-family: var(--font-sans);
		/* 20px * --ui-scale (0.8) = 16px real — readability floor for the
		   long-form paragraph copy case studies are built from. */
		font-size: calc(20px * var(--ui-scale));
		font-weight: 400;
		/* 1.65 (not 2) so a line break inside a paragraph reads tighter than
		   the gap between paragraphs below — at 2.0 the two were inverted:
		   a mid-paragraph line break (32px) had more air than the paragraph
		   boundary itself (12.8px), which is why paragraphs didn't read as
		   distinct chunks. */
		line-height: 1.65;
		/* 0.01em (~1%, 0.16px real): body text is set at 90% opacity on a dark
		   background here, and light-on-dark text optically thins and reads
		   tighter than the same weight would on a light background — a touch
		   of positive tracking corrects for that without reintroducing the
		   heavier +0.8px/5% tracking this used to carry, which was loose
		   enough to slow word-shape recognition. em-relative so it scales
		   automatically with --ui-scale instead of needing its own calc(). */
		letter-spacing: 0.01em;
		color: color-mix(in srgb, var(--color-text) 90%, transparent);
		/* 36px * 0.8 = 28.8px real, deliberately more than one line's height
		   (16px * 1.65 = 26.4px) so the paragraph gap reads as a real break,
		   not just another line. */
		margin-block: 0 calc(36px * var(--ui-scale));
	}
	.cs-section__copy :global(p:last-child) {
		margin-bottom: 0;
	}
	.cs-section__copy :global(h3) {
		font-family: var(--font-heading);
		/* 28px * 0.8 = 22.4px real — a real step between the 16px body copy
		   and the 36px (real) section heading, not just +3px like the
		   unstyled global h3 this used to fall back to. */
		font-size: calc(28px * var(--ui-scale));
		font-weight: 600;
		line-height: 1.3;
		letter-spacing: -0.2px;
		color: var(--color-text);
		/* Generous top margin (48px * 0.8 = 38.4px real) so an in-body
		   subheading visibly opens a new beat instead of sitting flush
		   against the paragraph/list above it — previously 0, inherited
		   from the unrelated global h3 rule. */
		margin-block: calc(48px * var(--ui-scale)) calc(16px * var(--ui-scale));
	}
	.cs-section__copy :global(ul),
	.cs-section__copy :global(ol) {
		padding-left: calc(24px * var(--ui-scale));
		margin-block: 0 calc(36px * var(--ui-scale));
		/* Tailwind's preflight resets list-style to none globally — restore
		   real markers for the markdown-rendered lists in the MDX body. */
		list-style: revert;
	}
	.cs-section__copy :global(li) {
		font-family: var(--font-sans);
		font-size: calc(20px * var(--ui-scale));
		line-height: 1.65;
		letter-spacing: 0.01em;
		color: color-mix(in srgb, var(--color-text) 90%, transparent);
		/* 10px * 0.8 = 8px real — tighter than the paragraph gap on purpose
		   (items in one list should read as a group), but enough to keep a
		   two-line bullet's own line break from out-spacing the gap to the
		   next bullet, same fix as the paragraph rule above. */
		margin-bottom: calc(10px * var(--ui-scale));
	}
	.cs-section__copy :global(strong),
	.cs-section__copy :global(b) {
		font-weight: 700;
		color: var(--color-text);
	}

	/* ── Responsive ── */
	@media (max-width: 960px) {
		.cs-section {
			padding-block: calc(96px * var(--ui-scale));
		}
		.cs-section__inner {
			padding-inline: var(--gutter-mobile);
		}
		.cs-section[data-layout='side'] .cs-section__inner {
			flex-direction: column;
			align-items: center;
		}
		/* Single column: every layout shares stacked's reading column, so
		   side copy and 'wide' copy don't run the full width while the
		   sections around them are centred. Side assets stack above the
		   copy at the same width and size to their content, as on desktop:
		   an image keeps its own ratio and CaseLogoBlock gives itself a box. */
		.cs-section[data-layout='side'] .cs-section__copy {
			flex: unset;
			width: min(calc(680px * var(--ui-scale)), 100%);
		}
		.cs-section[data-layout][data-wide] .cs-section__copy {
			width: min(calc(680px * var(--ui-scale)), 100%);
		}
		.cs-section[data-layout='side'] .cs-section__assets {
			align-self: center;
			width: min(calc(680px * var(--ui-scale)), 100%);
		}
		.cs-section[data-layout='stacked'] .cs-section__assets {
			flex-direction: column;
		}
		.cs-section[data-layout='stacked'] .cs-section__assets :global(img) {
			/* 375px * 0.8 = 300px real. */
			max-height: calc(375px * var(--ui-scale));
		}
	}

	/* ── Desktop: sticky chapter header ──
	   Every layout follows the same pattern: the header (number, tag,
	   heading) owns a left column and stays sticky while its section
	   scrolls; all copy and media flow in the right column. The copy wrapper
	   becomes display: contents so its header and body children join the
	   section grid directly. The header spans many implicit rows (empty ones
	   collapse to 0 with row-gap 0), so its height never stretches the first
	   content row; as a sticky grid item it travels within the whole section
	   and rests at the section's bottom when it ends. Below 961px the
	   stacked/side rules above apply. */
	@media (min-width: 961px) {
		.cs-section[data-layout] .cs-section__inner {
			display: grid;
			grid-template-columns: minmax(0, 4fr) minmax(0, 8fr);
			column-gap: calc(96px * var(--ui-scale));
			row-gap: 0;
			align-items: start;
		}
		.cs-section[data-layout] .cs-section__copy {
			display: contents;
		}
		.cs-section[data-layout] .cs-section__header {
			grid-column: 1;
			grid-row: 1 / span 99;
			position: sticky;
			top: calc(var(--component-header-height-desktop) + 32px * var(--ui-scale));
			margin-bottom: 0;
		}
		.cs-section[data-layout] .cs-section__copy > :global(:not(.cs-section__header)) {
			grid-column: 2;
			width: 100%;
			max-width: calc(820px * var(--ui-scale));
		}
		.cs-section[data-layout] .cs-section__assets {
			grid-column: 2;
			width: 100%;
			margin: 0 0 calc(64px * var(--ui-scale));
			justify-content: flex-start;
		}
		.cs-section[data-layout='side'] .cs-section__assets > :global(img) {
			border-radius: var(--radius-md);
		}
		.cs-section__copy > :global(.cs-image-row) {
			max-width: none;
			/* Top stays small: grid items don't collapse margins, so the
			   preceding paragraph's margin-bottom already adds to it. */
			margin-block: calc(8px * var(--ui-scale)) calc(56px * var(--ui-scale));
		}
		.cs-section__heading {
			max-width: none;
			font-size: clamp(calc(34px * var(--ui-scale)), 2.6vw, calc(46px * var(--ui-scale)));
		}
	}
	@media (max-width: 839px) {
		.cs-section[data-layout] .cs-section__copy {
			width: 100%;
		}
		.cs-section__header {
			margin-bottom: calc(48px * var(--ui-scale));
		}
		.cs-section__header::before {
			font-size: calc(48px * var(--ui-scale));
		}
		.cs-section__heading {
			font-size: calc(36px * var(--ui-scale));
		}
		.cs-section__copy > :global(.cs-image-row) {
			margin-block: calc(48px * var(--ui-scale));
		}
	}
</style>
