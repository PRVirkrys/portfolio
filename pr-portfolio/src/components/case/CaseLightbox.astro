---
// Click-to-enlarge gallery for a case study's content screenshots. Included
// once by CaseStudy.astro; wires itself up to every <img> inside .cs-article
// at runtime (event delegation would still need per-image affordance, so
// each image gets wrapped once instead — see the script below). Decorative
// marks inside CaseLogoBlock are skipped: they're brand logos, not content
// to zoom into.
//
// Visual language is pulled straight from the existing design system rather
// than invented: the close/prev/next buttons reuse Header.astro's circular
// icon-button recipe (transparent bg, --elevation-button-adaptive resting
// shadow, hover tint, outline focus-ring), and the per-image caption's
// eyebrow is a *clone* of that image's own CaseSection <Tag> pill — so it
// always matches the section's real tag color with zero duplicated CSS.
import { X, ChevronLeft, ChevronRight, Maximize2 } from '@lucide/astro';
---

<div class="cs-lightbox" id="cs-lightbox" hidden>
	<div class="cs-lightbox__backdrop" data-lightbox-close></div>
	<div class="cs-lightbox__dialog" role="dialog" aria-modal="true" aria-label="Galería de imágenes">
		<div class="cs-lightbox__topbar">
			<span class="cs-lightbox__counter" data-lightbox-counter></span>
			<button type="button" class="cs-lightbox__btn cs-lightbox__close" data-lightbox-close aria-label="Cerrar">
				<X />
			</button>
		</div>

		<div class="cs-lightbox__stage">
			<button type="button" class="cs-lightbox__btn cs-lightbox__nav cs-lightbox__nav--prev" data-lightbox-prev aria-label="Imagen anterior">
				<ChevronLeft />
			</button>

			<img class="cs-lightbox__image" data-lightbox-image alt="" />

			<button type="button" class="cs-lightbox__btn cs-lightbox__nav cs-lightbox__nav--next" data-lightbox-next aria-label="Siguiente imagen">
				<ChevronRight />
			</button>
		</div>

		<div class="cs-lightbox__caption" data-lightbox-caption hidden>
			<span class="cs-lightbox__caption-eyebrow" data-lightbox-eyebrow></span>
			<span class="cs-lightbox__caption-text" data-lightbox-caption-text></span>
		</div>
	</div>
</div>

<template data-lightbox-badge-template>
	<span class="cs-zoom-badge" aria-hidden="true"><Maximize2 /></span>
</template>

<script>
	function initCaseLightbox() {
		const article = document.querySelector('.cs-article');
		const modalEl = document.getElementById('cs-lightbox');
		if (!article || !modalEl) return;
		const modal = modalEl;

		const candidates = Array.from(article.querySelectorAll<HTMLImageElement>('img')).filter(
			(img) => !img.closest('.cs-logo-block'),
		);
		if (candidates.length === 0) return;

		const badgeTemplate = document.querySelector<HTMLTemplateElement>('[data-lightbox-badge-template]');
		const stageImage = modal.querySelector<HTMLImageElement>('[data-lightbox-image]')!;
		const counterEl = modal.querySelector<HTMLElement>('[data-lightbox-counter]')!;
		const captionEl = modal.querySelector<HTMLElement>('[data-lightbox-caption]')!;
		const eyebrowEl = modal.querySelector<HTMLElement>('[data-lightbox-eyebrow]')!;
		const captionTextEl = modal.querySelector<HTMLElement>('[data-lightbox-caption-text]')!;
		const closeEls = modal.querySelectorAll<HTMLElement>('[data-lightbox-close]');
		const prevBtn = modal.querySelector<HTMLButtonElement>('[data-lightbox-prev]')!;
		const nextBtn = modal.querySelector<HTMLButtonElement>('[data-lightbox-next]')!;

		type Item = { src: string; alt: string; tag: HTMLElement | null };
		const items: Item[] = candidates.map((img) => {
			const sectionTag = img.closest('.cs-section')?.querySelector<HTMLElement>('.cs-section__header .tag') ?? null;
			return { src: img.currentSrc || img.src, alt: img.alt, tag: sectionTag };
		});

		candidates.forEach((img, index) => {
			const wrap = document.createElement('span');
			wrap.className = 'cs-zoomable-wrap';
			img.replaceWith(wrap);
			wrap.appendChild(img);
			img.classList.add('cs-zoomable');
			img.tabIndex = 0;
			img.setAttribute('role', 'button');
			img.setAttribute('aria-label', 'Ampliar imagen');
			if (badgeTemplate) {
				wrap.appendChild(badgeTemplate.content.cloneNode(true));
			}
			const open = () => openAt(index);
			wrap.addEventListener('click', open);
			img.addEventListener('keydown', (e) => {
				if (e.key === 'Enter' || e.key === ' ') {
					e.preventDefault();
					open();
				}
			});
		});

		let current = 0;
		let lastFocused: HTMLElement | null = null;

		function render() {
			const item = items[current];
			stageImage.src = item.src;
			stageImage.alt = item.alt;
			counterEl.textContent = `${current + 1} / ${items.length}`;

			eyebrowEl.replaceChildren();
			if (item.tag) eyebrowEl.appendChild(item.tag.cloneNode(true));
			captionTextEl.textContent = item.alt;
			captionEl.hidden = !item.tag && !item.alt;

			prevBtn.hidden = items.length <= 1;
			nextBtn.hidden = items.length <= 1;
		}

		function openAt(index: number) {
			current = index;
			lastFocused = document.activeElement as HTMLElement | null;
			render();
			// Pinned to the current scroll position rather than position:fixed —
			// see the note on .cs-lightbox.
			modal.style.top = `${window.scrollY}px`;
			modal.hidden = false;
			document.addEventListener('keydown', onKeydown);
			requestAnimationFrame(() => {
				modal.querySelector<HTMLElement>('.cs-lightbox__close')?.focus({ preventScroll: true });
			});
		}

		function close() {
			modal.hidden = true;
			document.removeEventListener('keydown', onKeydown);
			lastFocused?.focus({ preventScroll: true });
		}

		function step(delta: number) {
			current = (current + delta + items.length) % items.length;
			render();
		}

		function onKeydown(e: KeyboardEvent) {
			if (e.key === 'Escape') close();
			else if (e.key === 'ArrowLeft') step(-1);
			else if (e.key === 'ArrowRight') step(1);
			else if (e.key === 'Tab') trapFocus(e);
		}

		function trapFocus(e: KeyboardEvent) {
			const focusables = Array.from(modal.querySelectorAll<HTMLElement>('button:not([hidden])'));
			if (focusables.length === 0) return;
			const first = focusables[0];
			const last = focusables[focusables.length - 1];
			if (e.shiftKey && document.activeElement === first) {
				e.preventDefault();
				last.focus();
			} else if (!e.shiftKey && document.activeElement === last) {
				e.preventDefault();
				first.focus();
			}
		}

		// Scroll lock lives on the lightbox itself (see `touch-action` in the
		// styles below) instead of toggling `body { overflow: hidden }` — the
		// lightbox is no longer position:fixed, so the page must not scroll
		// out from under it.
		modal.addEventListener('wheel', (e) => e.preventDefault(), { passive: false });

		closeEls.forEach((el) => el.addEventListener('click', close));
		prevBtn.addEventListener('click', () => step(-1));
		nextBtn.addEventListener('click', () => step(1));
	}

	initCaseLightbox();
</script>

<style>
	/* position:absolute (top set to scrollY on open), not fixed, because of
	   iOS 26 Safari: it tints the status bar by copying the background of a
	   position:fixed element touching the top edge (normally .header). A
	   fixed lightbox took that role while open and Safari never gave it back
	   after close, leaving the status bar see-through with page text behind
	   it for the rest of the visit. Safari ignores non-fixed elements, so the
	   header stays the tint source. Same approach React Spectrum took
	   (adobe/react-spectrum#8888). Rendered as a direct child of <body>
	   (unpositioned), so `top` is relative to the document. */
	.cs-lightbox {
		position: absolute;
		left: 0;
		width: 100%;
		/* lvh covers the area behind Safari's toolbars too; the dialog below
		   uses dvh so its controls stay within the visible part. */
		height: 100lvh;
		z-index: 200;
		display: flex;
		/* Blocks touch panning from reaching the page behind — part of the
		   scroll lock, see the `wheel` listener in the script above. */
		touch-action: none;
		overscroll-behavior: contain;
		/* --color-neutral-950 (the fixed dark navy swatch, not --color-bg): a
		   lightbox scrim needs to stay dark regardless of theme to dim the
		   page behind the enlarged image. Mixing off --color-bg used to do
		   that by accident in dark theme (where --color-bg is already almost
		   this same navy) but broke in light theme, where --color-bg is
		   near-white and 8% black barely dented it — the "backdrop" was
		   nearly the same colour as the page. */
		background: color-mix(in srgb, var(--color-neutral-950) 92%, black);
	}
	.cs-lightbox[hidden] {
		display: none;
	}
	/* Click target only — the scrim itself is painted on .cs-lightbox. */
	.cs-lightbox__backdrop {
		position: absolute;
		inset: 0;
	}
	.cs-lightbox__dialog {
		position: relative;
		z-index: 1;
		display: flex;
		flex-direction: column;
		width: 100%;
		height: 100dvh;
		padding: var(--space-6);
	}
	.cs-lightbox__topbar {
		display: flex;
		align-items: center;
		justify-content: space-between;
		flex-shrink: 0;
	}
	.cs-lightbox__counter {
		font-family: var(--font-sans);
		font-size: calc(14px * var(--ui-scale));
		font-weight: 600;
		letter-spacing: calc(2px * var(--ui-scale));
		color: var(--color-text-muted);
	}
	.cs-lightbox__stage {
		position: relative;
		flex: 1;
		min-height: 0;
		display: flex;
		align-items: center;
		justify-content: center;
		padding-inline: calc(80px * var(--ui-scale));
	}
	.cs-lightbox__image {
		max-width: 100%;
		max-height: 100%;
		width: auto;
		height: auto;
		object-fit: contain;
		border-radius: var(--radius-md);
		box-shadow: var(--elevation-floating);
	}

	/* Icon buttons — same recipe as Header.astro's circular mobile trigger. */
	.cs-lightbox__btn {
		display: grid;
		flex-shrink: 0;
		place-items: center;
		width: calc(52px * var(--ui-scale));
		height: calc(52px * var(--ui-scale));
		border: 0;
		border-radius: var(--radius-full);
		background: transparent;
		box-shadow: var(--elevation-button-adaptive);
		color: var(--color-text);
		cursor: pointer;
	}
	.cs-lightbox__btn:hover {
		background: var(--color-action-secondary-bg-hover);
	}
	.cs-lightbox__btn:focus-visible {
		outline: var(--focus-width) solid var(--color-focus);
		outline-offset: var(--space-1);
	}
	.cs-lightbox__btn :global(svg) {
		width: var(--icon-lg);
		height: var(--icon-lg);
	}
	.cs-lightbox__nav {
		position: absolute;
		top: 50%;
		transform: translateY(-50%);
	}
	.cs-lightbox__nav--prev {
		left: 0;
	}
	.cs-lightbox__nav--next {
		right: 0;
	}

	.cs-lightbox__caption {
		flex-shrink: 0;
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: var(--space-2);
		margin-top: var(--space-4);
		text-align: center;
	}
	.cs-lightbox__caption-text {
		max-width: min(calc(640px * var(--ui-scale)), 80vw);
		font-family: var(--font-sans);
		/* 18px * --ui-scale = 14.4px real — up from 12px, still a step below
		   body copy's 16px since this is a secondary caption, not reading text. */
		font-size: calc(18px * var(--ui-scale));
		line-height: 1.6;
		color: var(--color-text-muted);
	}

	@media (max-width: 640px) {
		.cs-lightbox__dialog {
			padding: var(--space-4);
		}
		.cs-lightbox__stage {
			padding-inline: calc(48px * var(--ui-scale));
		}
		.cs-lightbox__btn {
			width: calc(44px * var(--ui-scale));
			height: calc(44px * var(--ui-scale));
		}
	}
</style>

<style is:global>
	/* Wraps a gallery-eligible <img> at runtime — see the script above. */
	.cs-zoomable-wrap {
		position: relative;
		display: block;
		cursor: zoom-in;
	}
	.cs-zoomable-wrap .cs-zoomable {
		display: block;
	}
	.cs-zoom-badge {
		position: absolute;
		right: var(--space-3);
		bottom: var(--space-3);
		display: grid;
		place-items: center;
		width: calc(36px * var(--ui-scale));
		height: calc(36px * var(--ui-scale));
		border-radius: var(--radius-full);
		background: color-mix(in srgb, var(--color-bg) 70%, transparent);
		box-shadow: var(--elevation-button-adaptive);
		color: var(--color-text);
		opacity: 0;
		transform: scale(0.9);
		transition:
			opacity var(--duration-fast) var(--ease-standard),
			transform var(--duration-fast) var(--ease-standard);
		pointer-events: none;
	}
	.cs-zoom-badge svg {
		width: var(--icon-sm);
		height: var(--icon-sm);
	}
	.cs-zoomable-wrap:hover .cs-zoom-badge,
	.cs-zoomable-wrap:focus-within .cs-zoom-badge {
		opacity: 1;
		transform: scale(1);
	}
	@media (hover: none) {
		/* No hover on touch — keep the affordance visible so it's still
		   discoverable, just lighter than the hover state. */
		.cs-zoom-badge {
			opacity: 0.85;
			transform: none;
		}
	}
	.cs-zoomable:focus-visible {
		outline: var(--focus-width) solid var(--color-focus);
		outline-offset: var(--space-1);
		border-radius: var(--radius-md);
	}
</style>
