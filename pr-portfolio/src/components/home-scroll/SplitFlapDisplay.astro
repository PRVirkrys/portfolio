---
import SplitFlapCharacter from './SplitFlapCharacter.astro';
import { layoutMessage } from './split-flap';
interface Props {
  roles: string[];       // the flap-step roles (7) — also the sequence list
  name: string;          // "PAULA RODAS" — row 1 of the closing state
  closingRole: string;   // "DESIGNER" — row 2 of the closing state
  cols: number;          // plates per row (12 → a fixed 12 × 2 grid)
  prefixOpen: string;    // "I AM A"
  prefixClose: string;   // "I AM"
}
const { roles, name, closingRole, cols, prefixOpen, prefixClose } = Astro.props;
const pad = (s: string) => (s + ' '.repeat(cols)).slice(0, cols);
// Each entry is [row1, row2], every string exactly `cols` chars.
const lines: string[][] = [
  ...roles.map((role) => layoutMessage(role, cols)),
  [pad(name), pad(closingRole)],
];
// SSR paints the resting final state so no-JS / reduced motion shows it whole.
const rest = lines[lines.length - 1];
const cells = [...rest[0], ...rest[1]];
---
<div
  class="flap-row"
  data-flap-row
  data-flap-lines={JSON.stringify(lines)}
  data-flap-cols={cols}
  data-flap-prefix-open={prefixOpen}
  data-flap-prefix-close={prefixClose}
>
  <span class="sr-only" id="identity-title">{prefixClose} {name} {closingRole}</span>
  <span class="sr-only" data-flap-live aria-live="polite">{prefixClose} {name} {closingRole}</span>
  {cells.map((ch) => <SplitFlapCharacter char={ch} />)}
</div>
