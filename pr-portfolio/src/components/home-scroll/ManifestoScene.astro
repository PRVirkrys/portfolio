---
import Tag from '../ui/Tag.astro';
import TextLink from '../ui/TextLink.astro';
import { ArrowRight } from '@lucide/astro';
import type { HomeCopy } from './home-copy';
interface Props { copy: HomeCopy }
const { copy } = Astro.props;
const m = copy.manifesto;
---
<section class="home-scene home-manifesto" data-scene-panel="manifesto" aria-labelledby="manifesto-title">
  <div class="home-manifesto__inner" data-motion="manifesto-copy">
    <div class="home-tags"><Tag size="sm" category="UX Design">{m.tag}</Tag></div>
    <h2 id="manifesto-title" class="home-manifesto__lead" data-motion="manifesto-line">{m.lines[0]}</h2>
    <p class="home-manifesto__accent" data-motion="manifesto-line">{m.lines[1]}</p>
    <p class="home-manifesto__coda" data-motion="manifesto-line">{m.lines[2]}</p>
    <TextLink href="/work" showIcon={false}>{m.cta}<ArrowRight class="home-link-arrow" size={16} /></TextLink>
  </div>
</section>
