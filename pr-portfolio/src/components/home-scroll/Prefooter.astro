---
// Closing chapter of the home, after the pinned journey and before the global
// footer. It is the site's only contact surface (no form, no /contacto page):
// one primary action (email) and three secondary destinations.
import { ArrowUpRight } from '@lucide/astro';
import Button from '../ui/Button.astro';
import TextLink from '../ui/TextLink.astro';
import type { HomeCopy } from './home-copy';
import { withBase } from '../../lib/url';
interface Props { copy: HomeCopy }
const { copy } = Astro.props;
const t = copy.prefooter;
const external = { target: '_blank', rel: 'noopener noreferrer' };
---
<section id="contact" class="home-prefooter" aria-labelledby="prefooter-title">
  <div class="home-prefooter__inner">
    <h2 id="prefooter-title" class="home-prefooter__title">{t.title}</h2>
    <div class="home-prefooter__body">
      <p class="home-prefooter__text">{t.text}</p>
      <ul class="home-prefooter__links">
        <li class="home-prefooter__primary">
          <Button href="mailto:bypaularodas@gmail.com" variant="primary" size="lg" showLeadingIcon={false}>
            {t.email}
            <ArrowUpRight slot="icon-trailing" />
          </Button>
        </li>
        <li>
          <TextLink href="https://www.linkedin.com/in/paularodas/" size="lg" {...external}>
            {t.linkedin}<span class="sr-only"> {t.newTab}</span>
          </TextLink>
        </li>
        <li><TextLink href={withBase('/cv')} size="lg">{t.cv}</TextLink></li>
        <li>
          <TextLink href="https://github.com/PRVirkrys" size="lg" {...external}>
            {t.github}<span class="sr-only"> {t.newTab}</span>
          </TextLink>
        </li>
      </ul>
    </div>
  </div>
</section>
