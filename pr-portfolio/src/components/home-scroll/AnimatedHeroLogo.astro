---
import lower from '../../assets/home-scroll/logo-lower.svg';
import upper from '../../assets/home-scroll/logo-upper.svg';
import left from '../../assets/home-scroll/logo-left.svg';
---
<div class="hero-logo" data-motion="hero-logo" aria-hidden="true">
  <img class="hero-logo__piece hero-logo__piece--left" data-motion="logo-left" src={left.src} width="138" height="247" alt="" />
  <img class="hero-logo__piece hero-logo__piece--upper" data-motion="logo-upper" src={upper.src} width="147" height="141" alt="" />
  <img class="hero-logo__piece hero-logo__piece--lower" data-motion="logo-lower" src={lower.src} width="118" height="114" alt="" />
</div>
