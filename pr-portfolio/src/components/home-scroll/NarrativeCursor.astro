---
import cursor from '../../assets/home-scroll/cursor.svg?raw';

interface Props {
  label: string;
  class?: string;
}
const { label, class: className } = Astro.props;
---
<div class:list={['narrative-cursor', className]} data-narrative-cursor aria-hidden="true">
  <span class="narrative-cursor__pointer" set:html={cursor} />
  <span class="narrative-cursor__label">{label}</span>
  <span class="narrative-cursor__msg" data-cursor-msg></span>
</div>
