---
import mouse from '../../assets/home-scroll/scroll-mouse.svg?raw';
import phone from '../../assets/home-scroll/scroll-phone.svg?raw';
interface Props { label: string }
const { label } = Astro.props;
---
<div class="scroll-indicator" aria-hidden="true" data-motion="scroll-indicator">
  <span class="scroll-indicator__mouse" set:html={mouse} />
  <span class="scroll-indicator__phone" set:html={phone} />
  <span>{label}</span>
</div>
