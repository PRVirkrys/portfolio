---
import type { HomeCopy } from './home-copy';
import TextMark from './TextMark.astro';
interface Props { copy: HomeCopy }
const { copy } = Astro.props;
---
<section class="home-scene home-purpose" data-scene-panel="purpose" aria-labelledby="purpose-title">
  <div class="home-purpose__stage">
    <TextMark
      tag="h2"
      id="purpose-title"
      class="home-purpose__title"
      motion="purpose-title"
      parts={copy.purpose.parts}
      selected={false}
    />
    <svg class="purpose-mark" data-purpose-mark aria-hidden="true" xmlns="http://www.w3.org/2000/svg">
      <rect data-purpose-mark-rect fill="none" stroke-linecap="round" stroke-linejoin="round" />
    </svg>
  </div>
</section>
