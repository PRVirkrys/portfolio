---
import type { TextPart } from './home-copy';

interface Props {
  parts: TextPart[];
  tone?: 'white' | 'purple';
  selected?: boolean;
  tag?: 'span' | 'h2';
  id?: string;
  class?: string;
  motion?: string;
}

const {
  parts,
  tone = 'white',
  selected = false,
  tag = 'span',
  id,
  class: className,
  motion,
} = Astro.props;
const Tag = tag as 'span' | 'h2';
// Split into words and whitespace runs. Every glyph — spaces included — is a
// per-character span so the typing reveal (width 0 → natural) keeps the caret
// glued to the last typed glyph and the box grows with it. Line breaks happen
// only at the <wbr> before each word (there are no real whitespace text nodes),
// while `.text-mark__word` keeps a word's glyphs from breaking mid-word.
const tokenize = (text: string) => text.split(/(\s+)/).filter((t) => t.length > 0);
const isSpace = (t: string) => /^\s+$/.test(t);
---
<Tag
  class:list={['text-mark', className]}
  id={id}
  data-text-mark
  data-tone={tone}
  data-motion={motion}
  style={selected ? '--sel: 1' : undefined}
>
  <span class="text-mark__box">
    <span class="text-mark__text" data-text-mark-text
      >{parts.map((part) => (
        <span class="text-mark__part" data-emphasis={part.emphasis ? '' : undefined}
          >{tokenize(part.text).map((tok) =>
            isSpace(tok) ? (
              <span class="text-mark__char text-mark__char--space">{tok}</span>
            ) : (
              <Fragment><wbr /><span class="text-mark__word">{Array.from(tok).map((ch) => <span class="text-mark__char">{ch}</span>)}</span></Fragment>
            ),
          )}</span
        >
      ))}<span class="text-mark__caret" data-text-mark-caret aria-hidden="true">|</span></span
    >
  </span>
  <span class="text-mark__handle text-mark__handle--is" aria-hidden="true"></span>
  <span class="text-mark__handle text-mark__handle--ds" aria-hidden="true"></span>
  <span class="text-mark__handle text-mark__handle--ib" aria-hidden="true"></span>
  <span class="text-mark__handle text-mark__handle--db" aria-hidden="true"></span>
</Tag>
