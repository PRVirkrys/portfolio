---
import AnimatedHeroLogo from './AnimatedHeroLogo.astro';
import TextMark from './TextMark.astro';
import NarrativeCursor from './NarrativeCursor.astro';
import PurposeScene from './PurposeScene.astro';
import BoardScene from './BoardScene.astro';
import FigmaScene from './FigmaScene.astro';
import CodeScene from './CodeScene.astro';
import AIScene from './AIScene.astro';
import ManifestoScene from './ManifestoScene.astro';
import IdentityScene from './IdentityScene.astro';
import ScrollIndicator from './ScrollIndicator.astro';
import Tag from '../ui/Tag.astro';
import TextLink from '../ui/TextLink.astro';
import { homeCopy, type Locale } from './home-copy';
import { withBase } from '../../lib/url';
import './home-scroll.css';
interface Props { locale?: Locale }
const { locale = 'es' } = Astro.props;
const copy = homeCopy[locale];
---
<a class="home-skip" href={withBase('/work')}>{copy.skip}</a>
<main class="home-scroll" data-home-scroll data-locale={locale} tabindex="-1">
  <div class="home-stage">
    <div class="home-intro" data-intro-overlay aria-hidden="true">
      <span class="home-intro__line" data-intro-line></span>
    </div>
    <section class="home-scene home-greeting" data-scene-panel="greeting" aria-labelledby="greeting-title">
      <div class="home-greeting__layout">
        <AnimatedHeroLogo />
        <h1 id="greeting-title" class="home-greeting__text">
          <span class="sr-only">{copy.intro.greeting} {copy.intro.prefix} {copy.intro.name}</span>
          <span class="greeting-marks" data-greeting-marks aria-hidden="true">
            <TextMark class="greeting-mark" motion="greeting-mark-1" tone="white" parts={[{ text: copy.intro.greeting }]} />
            <TextMark class="greeting-mark" motion="greeting-mark-2" tone="white" parts={[{ text: copy.intro.prefix }]} />
            <TextMark class="greeting-mark" motion="greeting-mark-3" tone="purple" parts={[{ text: copy.intro.name }]} />
            <span class="greeting-group" data-greeting-group aria-hidden="true">
              <span class="text-mark__handle text-mark__handle--is"></span>
              <span class="text-mark__handle text-mark__handle--ds"></span>
              <span class="text-mark__handle text-mark__handle--ib"></span>
              <span class="text-mark__handle text-mark__handle--db"></span>
              <span class="greeting-group__tick greeting-group__tick--1"></span>
              <span class="greeting-group__tick greeting-group__tick--2"></span>
            </span>
          </span>
        </h1>
        <NarrativeCursor label={copy.intro.cursorLabel} class="narrative-cursor--greeting" />
      </div>
    </section>
    <PurposeScene copy={copy} />
    <section class="home-scene home-premise" data-scene-panel="premise" aria-labelledby="premise-title">
      <div class="home-copy" data-motion="premise-copy">
        <div class="home-tags"><Tag size="sm" category="Strategy">{copy.premise.tag}</Tag></div>
        <h2 id="premise-title">{copy.premise.title}</h2>
        <p>{copy.premise.body}</p>
        <TextLink href={withBase('/work')} size="lg">{copy.relatedProjects}</TextLink>
      </div>
    </section>
    <BoardScene copy={copy} />
    <FigmaScene copy={copy} />
    <CodeScene copy={copy} />
    <AIScene copy={copy} />
    <ManifestoScene copy={copy} />
    <IdentityScene copy={copy} />
    <svg class="home-ribbon" data-ribbon aria-hidden="true" preserveAspectRatio="none" xmlns="http://www.w3.org/2000/svg">
      <defs>
        <linearGradient id="home-ribbon-grad" x1="0" y1="0" x2="1" y2="1">
          <stop offset="0" class="home-ribbon__from" />
          <stop offset="0.55" class="home-ribbon__mid" />
          <stop offset="1" class="home-ribbon__to" />
        </linearGradient>
      </defs>
      <path data-ribbon-path fill="none" stroke="url(#home-ribbon-grad)" stroke-linecap="round" stroke-linejoin="round" />
    </svg>
  </div>
  <ScrollIndicator label={copy.scroll} />
</main>
<script>
  import { mountHomeScroll } from './home-scroll';
  mountHomeScroll();
</script>
