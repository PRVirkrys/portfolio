---
// Import the global.css file here so that it is included on
// all pages through the use of the <BaseHead /> component.
import '../styles/tokens/tokens.scss';
import '../styles/global.css';
import type { ImageMetadata } from 'astro';
import { getImage } from 'astro:assets';
import DefaultShareImage from '../assets/og-image.png';
import { SITE_TITLE } from '../consts';
import { withBase } from '../lib/url';

interface Props {
	title: string;
	description: string;
	image?: ImageMetadata;
}

const canonicalURL = new URL(Astro.url.pathname, Astro.site);

const { title, description, image = DefaultShareImage } = Astro.props;

// Link previews (WhatsApp, LinkedIn, Slack…) expect 1200×630; anything else
// gets cropped by each app its own way, so crop it here once.
const shareImage = await getImage({ src: image, width: 1200, height: 630, fit: 'cover', format: 'jpg', quality: 82 });
const shareImageUrl = new URL(shareImage.src, Astro.site ?? Astro.url);
---

<!-- Every page's <html> hardcodes class="dark" as the SSR default. This runs
     synchronously before first paint to correct it from a saved preference
     (ThemeToggle writes it), so switching to light never
     flashes dark first. -->
<script is:inline>
	(function () {
		try {
			if (localStorage.getItem('theme') === 'light') {
				document.documentElement.classList.remove('dark');
			}
		} catch {}
	})();
</script>

<!-- Global Metadata -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<link rel="icon" type="image/svg+xml" href={withBase('/favicon.svg')} />
<link rel="icon" type="image/png" sizes="32x32" href={withBase('/favicon-32x32.png')} />
<link rel="icon" type="image/png" sizes="16x16" href={withBase('/favicon-16x16.png')} />
<link rel="icon" href={withBase('/favicon.ico')} />
<link rel="apple-touch-icon" href={withBase('/apple-touch-icon.png')} />
<link rel="manifest" href={withBase('/site.webmanifest')} />
<link rel="sitemap" href={withBase('/sitemap-index.xml')} />
<link
	rel="alternate"
	type="application/rss+xml"
	title={SITE_TITLE}
	href={new URL('rss.xml', Astro.site)}
/>
<meta name="generator" content={Astro.generator} />

<!-- Canonical URL -->
<link rel="canonical" href={canonicalURL} />

<!-- Primary Meta Tags -->
<title>{title}</title>
<meta name="description" content={description} />

<!-- Open Graph / Facebook -->
<meta property="og:type" content="website" />
<meta property="og:url" content={Astro.url} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={shareImageUrl} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />

<!-- Twitter -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:image" content={shareImageUrl} />
