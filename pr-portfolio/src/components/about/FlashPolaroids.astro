---
// Stack of polaroids (Flash, the BMX chapter). Drag (or swipe) the top photo away and it slides
// to the back of the pile, revealing the next one. The arrow controls step
// forward (same as a throw) or back (the last card returns to the top), for
// keyboard and assistive tech too; without JS the stack shows the top photo.
import type { ImageMetadata } from 'astro';
import Polaroid from './Polaroid.astro';
import { ChevronLeft, ChevronRight } from '@lucide/astro';
import IconButton from '../ui/IconButton.astro';

interface Photo { src: ImageMetadata; alt: string; caption: string }
interface Props {
  photos: Photo[];
  /** Names the pile for assistive tech, e.g. 'Fotos de Flash'. */
  label: string;
  /** 'sm' fits beside text, e.g. inside a journey chapter. */
  size?: 'md' | 'sm';
}
const { photos, label, size = 'md' } = Astro.props;
const sizes = size === 'sm' ? '(max-width: 839px) 60vw, 240px' : '(max-width: 839px) 72vw, 320px';

// Fixed tilts so the pile looks hand-dropped but renders identically every time.
const tilts = [-3, 4, -6, 2, 6, -2];
---

<div class="polaroids" data-polaroids data-size={size}>
  <ul class="polaroids__stack" aria-label={label}>
    {photos.map((photo, index) => (
      <li class="polaroids__card" style={`z-index: ${photos.length - index};`} aria-hidden={index > 0 ? 'true' : undefined}>
        <Polaroid {...photo} tilt={tilts[index % tilts.length]} sizes={sizes} />
      </li>
    ))}
  </ul>
  <div class="polaroids__controls">
    <p class="polaroids__hint">Arrastra la foto para ver la siguiente</p>
    <div class="polaroids__nav">
      <IconButton label="Foto anterior" size={size === 'sm' ? 'md' : 'lg'} data-polaroids-prev><ChevronLeft aria-hidden="true" /></IconButton>
      <span class="polaroids__count" data-polaroids-count aria-live="polite">1 / {photos.length}</span>
      <IconButton label="Foto siguiente" size={size === 'sm' ? 'md' : 'lg'} data-polaroids-next><ChevronRight aria-hidden="true" /></IconButton>
    </div>
  </div>
</div>

<script>
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

  for (const root of document.querySelectorAll<HTMLElement>('[data-polaroids]')) {
    const stack = root.querySelector<HTMLElement>('.polaroids__stack')!;
    const next = root.querySelector<HTMLButtonElement>('[data-polaroids-next]')!;
    const prev = root.querySelector<HTMLButtonElement>('[data-polaroids-prev]')!;
    const count = root.querySelector<HTMLElement>('[data-polaroids-count]')!;
    const cards = [...stack.querySelectorAll<HTMLElement>('.polaroids__card')];
    let order = [...cards];
    let busy = false;
    let dragging = false;
    // Throws and returns: the strong ease-out lands the card fast, keeping
    // the window where a second click would be ignored short. The card fades
    // as it flies off (and back in), so it leaves rather than gets cut off.
    const motion = 'transform var(--duration-medium) var(--ease-out-strong), opacity var(--duration-medium) var(--ease-out-strong)';
    // Both properties end together; wait for the transform alone.
    const onMoved = (card: HTMLElement, done: () => void) => {
      const handler = (event: TransitionEvent) => {
        if (event.target !== card || event.propertyName !== 'transform') return;
        card.removeEventListener('transitionend', handler);
        done();
      };
      card.addEventListener('transitionend', handler);
    };

    const restack = () => {
      order.forEach((card, index) => {
        card.style.zIndex = String(order.length - index);
        if (index > 0) card.setAttribute('aria-hidden', 'true');
        else card.removeAttribute('aria-hidden');
      });
      count.textContent = `${cards.indexOf(order[0]) + 1} / ${cards.length}`;
    };

    // Throw the top card out in direction (dx, dy), then tuck it under the pile.
    const sendToBack = (dx: number, dy: number) => {
      const card = order[0];
      if (!card || busy) return;
      busy = true;
      const finish = () => {
        order = [...order.slice(1), card];
        restack();
        card.style.transition = 'none';
        card.style.transform = '';
        card.style.opacity = '';
        card.classList.remove('is-dragging');
        requestAnimationFrame(() => { card.style.transition = ''; busy = false; });
      };
      if (reduceMotion.matches) return finish();
      const length = Math.hypot(dx, dy) || 1;
      card.style.transition = motion;
      card.style.transform = `translate(${(dx / length) * 140}%, ${(dy / length) * 60}%) rotate(${dx > 0 ? 18 : -18}deg)`;
      card.style.opacity = '0';
      onMoved(card, finish);
    };

    // Pull the bottom card back onto the top, flying in from the left.
    const bringBack = () => {
      const card = order.at(-1);
      if (!card || busy || order.length < 2) return;
      order = [card, ...order.slice(0, -1)];
      restack();
      if (reduceMotion.matches) return;
      busy = true;
      card.style.transition = 'none';
      card.style.transform = 'translate(-140%, -12%) rotate(-18deg)';
      card.style.opacity = '0';
      card.getBoundingClientRect();
      card.style.transition = motion;
      card.style.transform = '';
      card.style.opacity = '';
      onMoved(card, () => { card.style.transition = ''; busy = false; });
    };

    stack.addEventListener('pointerdown', event => {
      const card = order[0];
      // A second finger mid-drag would reset the origin and make the card jump.
      if (busy || dragging || !card || !card.contains(event.target as Node)) return;
      dragging = true;
      const startX = event.clientX;
      const startY = event.clientY;
      const startTime = performance.now();
      let dx = 0;
      let dy = 0;
      card.setPointerCapture(event.pointerId);
      card.classList.add('is-dragging');

      const move = (moveEvent: PointerEvent) => {
        dx = moveEvent.clientX - startX;
        dy = moveEvent.clientY - startY;
        card.style.transform = `translate(${dx}px, ${dy}px) rotate(${dx / 20}deg)`;
      };
      const release = () => {
        card.removeEventListener('pointermove', move);
        card.removeEventListener('pointerup', release);
        card.removeEventListener('pointercancel', release);
        dragging = false;
        // Thrown when dragged far enough, or flicked: a quick short swipe is
        // as clear an intent as a long drag.
        const distance = Math.hypot(dx, dy);
        const velocity = distance / Math.max(1, performance.now() - startTime);
        if (distance > card.offsetWidth / 3 || (distance > 12 && velocity > 0.11)) {
          sendToBack(dx, dy);
        } else {
          card.classList.remove('is-dragging');
          card.style.transform = '';
        }
      };
      card.addEventListener('pointermove', move);
      card.addEventListener('pointerup', release);
      card.addEventListener('pointercancel', release);
    });

    next.addEventListener('click', () => sendToBack(1, -0.2));
    prev.addEventListener('click', bringBack);
  }
</script>

<style>
  .polaroids { display: grid; justify-items: center; gap: var(--space-8); }
  .polaroids__stack { position: relative; display: grid; width: min(calc(400px * var(--ui-scale)), 72vw); margin: 0; padding: 0; list-style: none; touch-action: none; }
  /* The card moves and spins while dragged; the polaroid inside keeps its own tilt. */
  .polaroids__card { grid-area: 1 / 1; transition: transform var(--duration-medium) var(--ease-out-strong); cursor: grab; user-select: none; }
  .polaroids__card.is-dragging { cursor: grabbing; transition: none; }
  .polaroids[data-size='sm'] { gap: var(--space-6); }
  .polaroids[data-size='sm'] .polaroids__stack { width: min(calc(280px * var(--ui-scale)), 60vw); }
  .polaroids__controls { display: grid; justify-items: center; gap: var(--space-2); }
  .polaroids__hint { margin: 0; font-size: calc(14px * var(--ui-scale)); color: var(--color-text-muted); }
  .polaroids__nav { display: flex; align-items: center; gap: var(--space-4); }
  .polaroids__count { min-width: 4ch; text-align: center; font-family: var(--font-heading); font-size: calc(16px * var(--ui-scale)); font-weight: 600; color: var(--color-text-secondary); font-variant-numeric: tabular-nums; }
  @media (prefers-reduced-motion: reduce) { .polaroids__card { transition: none; } }
</style>
