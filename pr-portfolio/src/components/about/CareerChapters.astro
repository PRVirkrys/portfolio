---
// Experience as chapters: a full-width intro (eyebrow, two-tone heading,
// subtitle), then an accordion of roles beside a marker that shows the open
// chapter's start year on a timeline. On tall-enough desktops the block
// pins while you scroll through it and scrolling opens each chapter in turn;
// elsewhere it's a plain click-to-open accordion. Without JS every chapter
// renders open.
import { getCollection } from 'astro:content';
import { ChevronDown, ArrowRight } from '@lucide/astro';
import Tag from '../ui/Tag.astro';
import { withBase } from '../../lib/url';
import type { WorkCompanyId } from '../../data/work-companies';

interface Chapter {
  start: number;
  /** Omit for an ongoing role. */
  end?: number;
  company: string;
  role: string;
  tagline: string;
  body: string;
  tags: string[];
  /** Links the chapter to its case studies on /work. */
  workCompany?: WorkCompanyId;
}
interface Props {
  chapters: Chapter[];
  eyebrow: string;
  heading: string;
  /** Second heading line, set in a quieter tone. */
  headingMuted?: string;
  intro?: string;
  headingId: string;
}
const { chapters, eyebrow, heading, headingMuted, intro, headingId } = Astro.props;

const cases = await getCollection('blog', ({ data }) => data.type === 'case-study');
const casesFor = (company?: WorkCompanyId) => company ? cases.filter(entry => entry.data.company === company) : [];
// Case titles read "Customer · Subtitle"; the chip only needs the customer.
const caseLabel = (title: string) => title.split(' · ')[0];

const axisStart = Math.min(...chapters.map(chapter => chapter.start));
const axisEnd = new Date().getFullYear();
const axisPosition = (year: number) => ((year - axisStart) / (axisEnd - axisStart)) * 100;
---

<div class="career">
  <header class="career__intro">
    <p class="career__eyebrow">{eyebrow}</p>
    <h2 id={headingId}>{heading}{headingMuted && <><br /><span class="career__heading-muted">{headingMuted}</span></>}</h2>
    {intro && <p class="career__lede">{intro}</p>}
  </header>
  <div class="career__hold" data-career>
  <div class="career__stage" data-career-stage>
    <div class="career__head">
      <div class="career__marker" aria-hidden="true">
        <span class="career__label">Capítulo</span>
        <strong class="career__year" data-career-year>{chapters[0].start}</strong>
        <div class="career__axis">
          <i data-career-dot style={`left: ${axisPosition(chapters[0].start)}%;`}></i>
          <span>{axisStart}</span><span>Hoy</span>
        </div>
      </div>
    </div>
    <ol class="career__chapters">
      {chapters.map((chapter, index) => {
        const projects = casesFor(chapter.workCompany);
        return (
          <li class="chapter" data-career-chapter data-year={chapter.start} data-position={axisPosition(chapter.start)}>
            <button type="button" class="chapter__row" id={`chapter-${index}`} aria-expanded="true" aria-controls={`chapter-body-${index}`}>
              <span class="chapter__period">{chapter.start} – {chapter.end ?? 'Hoy'}</span>
              <span class="chapter__label"><strong>{chapter.company}</strong><span>{chapter.role}</span></span>
              <ChevronDown class="chapter__icon" aria-hidden="true" />
            </button>
            <div class="chapter__body" id={`chapter-body-${index}`} role="region" aria-labelledby={`chapter-${index}`}>
              <h3>{chapter.tagline}</h3>
              <p>{chapter.body}</p>
              <ul class="chapter__tags" aria-label="Ámbitos">
                {chapter.tags.map(tag => <li><Tag category="Neutral">{tag}</Tag></li>)}
              </ul>
              {projects.length > 0 && (
                <div class="chapter__projects">
                  <span class="chapter__projects-label" id={`chapter-cases-${index}`}>Case studies</span>
                  <ul aria-labelledby={`chapter-cases-${index}`}>
                    {projects.map(entry => (
                      <li><a href={withBase(`/work/${entry.id}/`)}>{caseLabel(entry.data.title)}<ArrowRight aria-hidden="true" /></a></li>
                    ))}
                  </ul>
                </div>
              )}
            </div>
          </li>
        );
      })}
    </ol>
  </div>
  </div>
</div>

<script>
  const scrollMode = window.matchMedia('(min-width: 961px) and (min-height: 760px)');
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

  for (const root of document.querySelectorAll<HTMLElement>('[data-career]')) {
    const stage = root.querySelector<HTMLElement>('[data-career-stage]')!;
    const year = root.querySelector<HTMLElement>('[data-career-year]')!;
    const dot = root.querySelector<HTMLElement>('[data-career-dot]')!;
    const marker = root.querySelector<HTMLElement>('.career__marker')!;
    const list = root.querySelector<HTMLElement>('.career__chapters')!;
    const chapters = [...root.querySelectorAll<HTMLElement>('[data-career-chapter]')];
    let active = -1;
    let pinned = false;
    // Scroll distance that advances one chapter while pinned.
    const step = () => window.innerHeight * 0.45;
    const stickyTop = () => parseFloat(getComputedStyle(stage).top) || 0;

    // The marker travels down beside the open chapter, kept inside the list.
    const alignMarker = () => {
      const chapter = chapters[active];
      if (!chapter) return;
      const offset = chapter.getBoundingClientRect().top - list.getBoundingClientRect().top;
      const max = Math.max(0, list.offsetHeight - marker.offsetHeight);
      marker.style.transform = `translateY(${Math.min(offset, max)}px)`;
    };

    const open = (index: number) => {
      if (index === active) return;
      const previous = active;
      active = index;
      chapters.forEach((chapter, i) => {
        const isOpen = i === index;
        chapter.classList.toggle('is-open', isOpen);
        chapter.querySelector('.chapter__row')!.setAttribute('aria-expanded', String(isOpen));
        chapter.querySelector<HTMLElement>('.chapter__body')!.hidden = !isOpen;
      });
      const chapter = chapters[index];
      alignMarker();
      dot.style.left = `${chapter.dataset.position}%`;
      if (year.textContent === chapter.dataset.year) return;
      year.textContent = chapter.dataset.year ?? '';
      // Later chapters are earlier years: moving down the list rolls the year
      // up out of view, moving back rolls it down.
      if (previous >= 0 && !reduceMotion.matches) {
        const from = index > previous ? '40%' : '-40%';
        year.animate(
          [{ opacity: 0, transform: `translateY(${from})` }, { opacity: 1, transform: 'none' }],
          { duration: 400, easing: 'cubic-bezier(0.2, 0.8, 0.2, 1)' },
        );
      }
    };

    // While a click scrolls to a chapter's slot, the chapters passed on the
    // way must not open; scroll-driven syncing resumes once scrolling settles.
    let locked = false;
    let lockTimer = 0;
    const release = () => { locked = false; syncToScroll(); };
    const holdLock = () => { window.clearTimeout(lockTimer); lockTimer = window.setTimeout(release, 150); };

    const syncToScroll = () => {
      if (!pinned) return;
      if (locked) return holdLock();
      const scrolled = stickyTop() - root.getBoundingClientRect().top;
      open(Math.min(chapters.length - 1, Math.max(0, Math.floor(scrolled / step()))));
    };

    // Pin only when the whole block fits on screen with any chapter open;
    // otherwise sticky would hide part of it.
    const layout = () => {
      alignMarker();
      root.style.height = '';
      stage.classList.remove('is-pinned');
      pinned = scrollMode.matches && stage.offsetHeight <= window.innerHeight - stickyTop();
      if (pinned) {
        stage.classList.add('is-pinned');
        root.style.height = `${stage.offsetHeight + step() * (chapters.length - 1) + step() * 0.5}px`;
        syncToScroll();
      }
    };

    chapters.forEach((chapter, index) => {
      const row = chapter.querySelector<HTMLElement>('.chapter__row')!;
      row.addEventListener('click', () => {
        if (pinned) {
          // Move to this chapter's scroll slot so scrolling continues from it.
          locked = true;
          holdLock();
          open(index);
          const top = window.scrollY + root.getBoundingClientRect().top - stickyTop() + index * step() + 1;
          window.scrollTo({ top, behavior: reduceMotion.matches ? 'auto' : 'smooth' });
          return;
        }
        // Unpinned, closing a chapter above would pull the clicked row up
        // under the cursor; compensate so the row stays where it was.
        const before = row.getBoundingClientRect().top;
        open(index);
        window.scrollBy(0, row.getBoundingClientRect().top - before);
      });
    });

    open(0);
    layout();
    window.addEventListener('scroll', syncToScroll, { passive: true });
    window.addEventListener('scrollend', () => { if (locked) { window.clearTimeout(lockTimer); release(); } });
    window.addEventListener('resize', layout);
  }
</script>

<style>
  .career__stage { display: grid; grid-template-columns: minmax(0, 4fr) minmax(0, 8fr); column-gap: calc(96px * var(--ui-scale)); align-items: start; }
  .career__stage.is-pinned { position: sticky; top: calc(var(--component-header-height-desktop) + var(--space-8)); }
  /* ── Intro: spans the whole column above the two-column stage ── */
  .career__intro { display: grid; gap: var(--space-6); margin-bottom: calc(96px * var(--ui-scale)); }
  .career__eyebrow { margin: 0; font-family: var(--font-heading); font-size: calc(14px * var(--ui-scale)); font-weight: 700; letter-spacing: calc(4px * var(--ui-scale)); text-transform: uppercase; color: var(--color-action-ghost-text); }
  h2 { margin: 0; font-family: var(--font-heading); font-size: clamp(calc(48px * var(--ui-scale)), 5vw, calc(80px * var(--ui-scale))); font-weight: 700; line-height: 1.05; letter-spacing: -0.035em; }
  .career__heading-muted { color: var(--color-text-muted); }
  .career__lede { max-width: 52ch; margin: 0; font-size: calc(22px * var(--ui-scale)); line-height: 1.5; color: var(--color-text-secondary); }
  .career__head { display: grid; }

  /* ── Marker: current chapter's year on a timeline ── */
  .career__marker { display: grid; gap: var(--space-4); padding-top: var(--space-6); border-top: var(--border-width) solid var(--color-border); transition: transform var(--duration-slow) var(--ease-standard); }
  .career__label { font-family: var(--font-heading); font-size: calc(12px * var(--ui-scale)); font-weight: 700; letter-spacing: calc(4px * var(--ui-scale)); text-transform: uppercase; color: var(--color-text-muted); }
  .career__year { display: block; overflow: hidden; font-family: var(--font-heading); font-size: clamp(calc(96px * var(--ui-scale)), 9vw, calc(160px * var(--ui-scale))); font-weight: 700; line-height: 1; letter-spacing: -0.05em; color: var(--color-text); font-variant-numeric: tabular-nums; }
  .career__axis { position: relative; display: flex; justify-content: space-between; padding-top: var(--space-4); border-top: var(--border-width) solid var(--color-border-strong); font-size: calc(14px * var(--ui-scale)); color: var(--color-text-muted); }
  .career__axis i { position: absolute; top: calc(-5px * var(--ui-scale)); width: calc(9px * var(--ui-scale)); height: calc(9px * var(--ui-scale)); margin-left: calc(-4.5px * var(--ui-scale)); border-radius: var(--radius-full); background: var(--color-action-ghost-text); transition: left var(--duration-slow) var(--ease-standard); }

  /* ── Chapters ── */
  .career__chapters { margin: 0; padding: 0; list-style: none; border-top: var(--border-width) solid var(--color-border); }
  .chapter { border-bottom: var(--border-width) solid var(--color-border); }
  .chapter__row { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: var(--space-1) var(--space-4); width: 100%; padding: var(--space-6) 0; border: 0; background: transparent; color: inherit; font: inherit; text-align: left; cursor: pointer; }
  .chapter__row:focus-visible { outline: var(--focus-width) solid var(--color-focus); outline-offset: var(--space-1); }
  .chapter__period { grid-column: 1; font-family: var(--font-heading); font-size: calc(14px * var(--ui-scale)); font-weight: 600; color: var(--color-text-muted); font-variant-numeric: tabular-nums; }
  .chapter__label { grid-column: 1; display: grid; gap: var(--space-1); }
  .chapter__label strong { font-family: var(--font-heading); font-size: calc(32px * var(--ui-scale)); font-weight: 700; line-height: 1.15; letter-spacing: -0.02em; color: var(--color-text); }
  .chapter__label span { font-size: calc(16px * var(--ui-scale)); color: var(--color-text-secondary); }
  .chapter__row :global(.chapter__icon) { grid-column: 2; grid-row: 1 / span 2; align-self: center; width: var(--icon-md); height: var(--icon-md); color: var(--color-text-muted); transition: transform var(--duration-medium) var(--ease-standard); }
  .chapter.is-open :global(.chapter__icon) { transform: rotate(180deg); color: var(--color-action-ghost-text); }
  @media (hover: hover) { .chapter__row:hover .chapter__label strong { color: var(--color-action-ghost-text); } }

  .chapter__body { display: grid; gap: var(--space-4); padding-bottom: var(--space-8); animation: chapter-in var(--duration-slow) var(--ease-standard); }
  .chapter__body[hidden] { display: none; }
  .chapter__body h3 { margin: 0; font-family: var(--font-heading); font-size: calc(24px * var(--ui-scale)); font-weight: 600; line-height: 1.3; letter-spacing: -0.2px; }
  .chapter__body p { max-width: calc(760px * var(--ui-scale)); margin: 0; font-size: calc(18px * var(--ui-scale)); line-height: 1.6; color: var(--color-text-secondary); }
  .chapter__tags, .chapter__projects ul { display: flex; flex-wrap: wrap; gap: var(--space-2); margin: 0; padding: 0; list-style: none; }
  .chapter__projects { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-3); margin-top: var(--space-2); }
  .chapter__projects-label { font-family: var(--font-heading); font-size: calc(12px * var(--ui-scale)); font-weight: 700; letter-spacing: calc(2px * var(--ui-scale)); text-transform: uppercase; color: var(--color-text-muted); }
  .chapter__projects a { display: inline-flex; align-items: center; gap: var(--space-2); min-height: var(--control-sm); padding: 0 var(--space-4); border: var(--border-width) solid var(--color-border-strong); border-radius: var(--radius-full); background: var(--color-surface); color: var(--color-text); font-size: calc(14px * var(--ui-scale)); font-weight: 600; text-decoration: none; transition: background-color var(--duration-fast) var(--ease-standard), border-color var(--duration-fast) var(--ease-standard); }
  .chapter__projects a :global(svg) { width: var(--icon-sm); height: var(--icon-sm); color: var(--color-action-ghost-text); transition: transform var(--duration-fast) var(--ease-standard); }
  @media (hover: hover) {
    .chapter__projects a:hover { background: var(--color-action-secondary-bg-hover); border-color: var(--color-action-ghost-text); }
    .chapter__projects a:hover :global(svg) { transform: translateX(2px); }
  }
  .chapter__projects a:focus-visible { outline: var(--focus-width) solid var(--color-focus); outline-offset: var(--space-1); }
  @keyframes chapter-in { from { opacity: 0; transform: translateY(calc(8px * var(--ui-scale))); } }

  /* Stacked, the marker would sit far above the chapter being read — each
     row already shows its period, so it's dropped. */
  @media (max-width: 960px) {
    .career__stage { grid-template-columns: minmax(0, 1fr); row-gap: var(--space-8); }
    .career__head { display: none; }
  }
  @media (max-width: 839px) {
    h2 { font-size: calc(44px * var(--ui-scale)); }
    .career__intro { margin-bottom: var(--space-12); }
    .career__lede { font-size: calc(18px * var(--ui-scale)); }
    .chapter__label strong { font-size: calc(26px * var(--ui-scale)); }
  }
  @media (prefers-reduced-motion: reduce) {
    .chapter__body { animation: none; }
    .career__marker, .career__axis i, .chapter__row :global(.chapter__icon) { transition: none; }
  }
</style>
