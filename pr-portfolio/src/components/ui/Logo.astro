---
// Figma: PR Brand (DS) → UI kit → Logo (node 15688:2855)
// The multicolor mark is the brand signature and must never be recolored or
// detached (see .Logo/Mark Original, Figma node 15673:104). "light" keeps the
// original mark inside the approved dark safety frame rather than recoloring
// it; "light-op2" is an explicit alternative exploration, not the default.
import logoOriginal from '../../assets/brand/logo-original.svg?raw';
import logoLightOp2 from '../../assets/brand/logo-light-op2.svg?raw';
import logoLightMode from '../../assets/brand/logo-light-mode.svg?raw';

export interface Props {
	theme?: 'dark' | 'light' | 'light-op2';
	class?: string;
}

const { theme = 'dark', class: className } = Astro.props;
const rawSvg = theme === 'light-op2' ? logoLightOp2 : logoOriginal;
const framed = theme === 'light';

// The source SVG's gradient defs use bare ids (e.g. id="paint0_linear_..."),
// which collide once <Logo> renders more than once on a page (sidebar +
// mobile header both do now) — the browser resolves every url(#id) to the
// FIRST such id in the DOM, so the second instance's paths sample the first
// instance's gradient in the wrong coordinate space and render as
// near-invisible fragments. Suffixing every id/reference with a per-instance
// token keeps each inlined copy self-contained.
const uid = Math.random().toString(36).slice(2, 9);
const namespaceIds = (svg: string, suffix: string) =>
	svg.replace(/(id="|url\(#)([\w.-]+)/g, (_match, prefix, id) => `${prefix}${id}-${uid}-${suffix}`);
const markSvg = namespaceIds(rawSvg, 'a');

// Only the unthemed default mark auto-swaps with the site's light/dark
// toggle — an explicit theme prop ('light' framing, 'light-op2') is a
// deliberate per-placement choice and stays fixed regardless of site theme.
const isDefaultMark = theme === 'dark';
const lightModeSvg = isDefaultMark ? namespaceIds(logoLightMode, 'b') : null;
---

<span class:list={['logo', framed && 'logo--framed', className]} aria-hidden="true">
	<span class="logo__mark logo__mark--current" set:html={markSvg} />
	{lightModeSvg && <span class="logo__mark logo__mark--site-light" set:html={lightModeSvg} />}
</span>

<style>
	.logo {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: calc(48px * var(--ui-scale));
		aspect-ratio: 89 / 77;
	}

	.logo :global(svg) {
		width: 100%;
		height: 100%;
	}

	/* Site-theme-driven swap for the default (unthemed) mark: dark mode shows
	   the original mark, light mode shows the light-mode export. Pure CSS
	   keyed off <html>'s .dark class (set by BaseHead's blocking init script
	   before first paint) so there's no flash and no client JS needed here. */
	.logo__mark {
		display: contents;
	}
	.logo__mark--site-light {
		display: none;
	}
	:global(html:not(.dark)) .logo__mark--current {
		display: none;
	}
	:global(html:not(.dark)) .logo__mark--site-light {
		display: contents;
	}

	.logo--framed {
		background-color: var(--logo-safety-surface);
		border-radius: var(--radius-lg);
		padding: var(--space-2);
		width: calc(48px * var(--ui-scale) + var(--space-2) * 2);
	}
</style>
