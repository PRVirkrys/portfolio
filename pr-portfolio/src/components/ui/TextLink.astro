---
// Figma: PR Brand (DS) → UI kit → TextLink (node 15659:2182)
// Underline is a single persistent ::after (see .text-link::after): the same
// --gradient-link-underline background-image, at the same oversized
// background-size, is declared once and never swapped between states. Only
// animation-play-state toggles on hover; background-position is what slides.
import type { HTMLAttributes } from 'astro/types';

// Other anchor attributes (target, rel, aria-*) pass through to the <a>.
export interface Props extends Omit<HTMLAttributes<'a'>, 'href' | 'class'> {
	href: string;
	size?: 'md' | 'lg';
	showIcon?: boolean;
	disabled?: boolean;
	class?: string;
}

const { href, size = 'md', showIcon = true, disabled = false, class: className, ...rest } = Astro.props;
---

<a
	class:list={['text-link', className]}
	data-size={size}
	href={!disabled ? href : undefined}
	aria-disabled={disabled ? 'true' : undefined}
	tabindex={disabled ? -1 : undefined}
	{...rest}
>
	<span class="text-link__content">
		<span class="text-link__label"><slot /></span>
		{
			showIcon && (
				<svg class="text-link__icon" viewBox="0 0 16 16" fill="none" aria-hidden="true">
					<path
						d="M5 11L11 5M11 5H6M11 5V10"
						stroke="currentColor"
						stroke-width="1.3"
						stroke-linecap="round"
						stroke-linejoin="round"
					/>
				</svg>
			)
		}
	</span>
</a>

<style>
	/* --gradient-link-underline is a symmetric red-mauve-blue-mauve-red
	   palindrome rendered at background-size 200% 100%, so the box only ever
	   shows half of it at a time. Sliding background-position by exactly one
	   full image period returns to a pixel-identical view — no seam at the
	   loop point — and passes through the mirrored/inverted orientation
	   naturally at the midpoint, so no separate "reversed" gradient or state
	   selector is needed for that. The target is -200% rather than +200% so
	   the sweep runs right-to-left; it's still exactly one image period
	   (just traversed the other way), and the base value below is still 0%,
	   so the resting/first frame is untouched. Sliding position this way
	   (rather than rotating the gradient's own angle, tried earlier) is also
	   what avoids the jump the previous version had: rotating a gradient's
	   direction degenerates badly on a box this thin, while a plain
	   horizontal translation doesn't care about the box's aspect ratio. */
	@keyframes link-underline-slide {
		to {
			background-position: -200% 0;
		}
	}

	/* Hover entrance: the line redraws itself left to right. */
	@keyframes link-underline-draw {
		from {
			transform: scaleX(0);
		}
	}

	.text-link {
		display: inline-flex;
		flex-direction: column;
		padding: var(--space-1);
		color: var(--link-text);
		text-decoration: none;
		outline: none;
	}

	.text-link[aria-disabled='true'] {
		pointer-events: none;
		opacity: 0.5;
	}

	.text-link__content {
		display: inline-flex;
		align-items: center;
		gap: var(--space-1);
		font-family: var(--typography-ui-link-md-font-family);
		font-weight: var(--typography-ui-link-md-font-weight);
		font-size: var(--typography-ui-link-md-font-size);
		line-height: var(--typography-ui-link-md-line-height);
		letter-spacing: var(--typography-ui-link-md-letter-spacing);
	}

	.text-link[data-size='lg'] .text-link__content {
		font-family: var(--typography-ui-link-lg-font-family);
		font-weight: var(--typography-ui-link-lg-font-weight);
		font-size: var(--typography-ui-link-lg-font-size);
		line-height: var(--typography-ui-link-lg-line-height);
		letter-spacing: var(--typography-ui-link-lg-letter-spacing);
	}

	.text-link__icon {
		flex-shrink: 0;
		width: var(--icon-sm);
		height: var(--icon-sm);
		color: inherit;
	}

	/* The underline itself: a generated box, not a markup span, so there is
	   only ever one element and it can't be replaced or duplicated between
	   states. background-image, background-size and background-position are
	   declared once here and never touched by any state selector — at
	   background-position 0% (its resting value) the oversized layer shows
	   exactly the gradient's left half: red at the left edge fading through
	   mauve to blue at the right edge, matching the approved Default look.
	   The animation is always declared too — only animation-play-state ever
	   changes, so it's never created or destroyed by a state selector. */
	.text-link::after {
		content: '';
		display: block;
		/* One thickness in every state (the hover weight): growing it on
		   hover pushed the link's box and made it jump. Hover is signalled by
		   the gradient sliding instead. Same weight as the primary Button's
		   gradient border (--border-width). */
		height: var(--border-width);
		background-image: var(--gradient-link-underline);
		background-repeat: repeat-x;
		background-size: 200% 100%;
		background-position: 0% 0;
		transform-origin: left center;
		animation: link-underline-slide 3s linear infinite;
		animation-play-state: paused;
	}

	/* Only hover starts the slide — focus-visible and :active leave
	   animation-play-state untouched (still paused, or still running if the
	   pointer also happens to be hovering), so neither can restart or reset
	   the animation on its own. */
	.text-link:hover::after {
		animation-play-state: running;
	}

	/* With a pointer that hovers, entering also redraws the line. The draw
	   is added as a second animation: animations are matched by name, so
	   the slide keeps running from where it was instead of restarting. */
	@media (hover: hover) and (pointer: fine) {
		.text-link:hover::after {
			animation-name: link-underline-slide, link-underline-draw;
			animation-duration: 3s, 350ms;
			animation-timing-function: linear, var(--ease-out-strong);
			animation-iteration-count: infinite, 1;
			animation-play-state: running, running;
		}
	}

	.text-link:focus-visible {
		box-shadow: var(--link-focus-ring);
		border-radius: var(--radius-sm);
	}

	.text-link[aria-disabled='true']::after {
		background-image: none;
		background-color: var(--link-text);
		animation: none;
	}

	@media (prefers-reduced-motion: reduce) {
		/* Overrides the :hover rules above (declared after them, same
		   specificity) so hovering neither slides nor redraws the line. */
		.text-link:hover::after {
			animation-name: link-underline-slide;
			animation-play-state: paused;
		}
	}
</style>
