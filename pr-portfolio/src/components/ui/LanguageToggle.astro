---
// Figma: PR Brand (DS) → LanguageToggle (node 16070:2167), used inside the
// header's "Language menu" panel (node 16067:68076).
// Intentionally inert for now — real i18n is a separate, much larger piece
// of work (see conversation). This renders the "Language=ES" default state
// and does nothing on click so it doesn't look broken while that's pending.
export interface Props {
	label?: string;
	showLabel?: boolean;
	/** 'icon': header icon button showing the language you'd switch TO, with
	 * a tooltip naming it in that language (pairs with ThemeToggle's icon). */
	/** 'row': full-width menu row (mobile menu panel) — the tooltip's text
	 * shown inline, since touch has no hover. */
	variant?: 'switch' | 'icon' | 'row';
}

const { label = 'Español', showLabel = true, variant = 'switch' } = Astro.props;
---

{variant === 'icon' ? (
	<span class="tooltip-anchor">
		<!-- aria-disabled (not disabled) keeps it focusable so keyboard users
		     still reach the tooltip; it does nothing on click while inert. -->
		<button type="button" class="language-toggle__icon-button" aria-disabled="true" aria-label="View in English (coming soon)" lang="en">EN</button>
		<span class="tooltip tooltip--end" aria-hidden="true" lang="en">View in English · coming soon</span>
	</span>
) : variant === 'row' ? (
	<button type="button" class="language-toggle__row" aria-disabled="true" lang="en">
		<span class="language-toggle__row-code" aria-hidden="true">EN</span>
		View in English
		<span class="language-toggle__row-soon" lang="es">Próximamente</span>
	</button>
) : (
<div class="language-toggle">
	<button type="button" class="language-toggle__control" disabled aria-disabled="true" title="Próximamente">
		<span class="language-toggle__track">
			<span class="language-toggle__option language-toggle__option--en">EN</span>
			<span class="language-toggle__option language-toggle__option--es">ES</span>
			<span class="language-toggle__thumb" aria-hidden="true"></span>
		</span>
	</button>
	{showLabel && <span class="language-toggle__label">{label}</span>}
</div>
)}

<style>
	.language-toggle {
		display: flex;
		align-items: center;
		gap: var(--space-2);
		height: calc(44px * var(--ui-scale));
	}
	.language-toggle__control {
		display: block;
		flex-shrink: 0;
		padding: calc(6px * var(--ui-scale)) 0;
		border: 0;
		background: transparent;
		/* Visually inert, not just non-interactive: no pointer/hover affordance. */
		cursor: default;
	}
	.language-toggle__track {
		position: relative;
		display: block;
		width: calc(52px * var(--ui-scale));
		height: calc(32px * var(--ui-scale));
		border: var(--border-width) solid #2bbafe;
		border-radius: var(--radius-full);
		background: var(--color-surface-raised);
	}
	.language-toggle__option {
		position: absolute;
		top: 50%;
		transform: translateY(-50%);
		font-family: var(--font-sans);
		font-size: calc(9px * var(--ui-scale));
		font-weight: 600;
		white-space: nowrap;
	}
	.language-toggle__option--en {
		left: calc(9px * var(--ui-scale));
		color: var(--color-text-muted);
	}
	.language-toggle__option--es {
		right: calc(8px * var(--ui-scale));
		/* Sits on the always-white thumb: fixed dark ink (see ThemeToggle),
		   and stacked above the thumb, which comes later in the DOM. */
		z-index: 1;
		color: var(--color-neutral-950);
	}
	.language-toggle__thumb {
		position: absolute;
		top: calc(3px * var(--ui-scale));
		/* ES is the only state today, so the thumb is parked over it. */
		left: calc(23px * var(--ui-scale));
		width: calc(24px * var(--ui-scale));
		height: calc(24px * var(--ui-scale));
		border-radius: var(--radius-full);
		/* Same reasoning as ThemeToggle's thumb: a border so the white thumb
		   stays visible against the near-white light-theme track now that the
		   shadow it used to lean on is flat (none) in light theme. */
		border: var(--border-width) solid var(--color-border);
		background: var(--color-base-white);
		box-shadow: var(--elevation-button-adaptive);
	}
	/* Same footprint as ThemeToggle's icon variant beside it. */
	.language-toggle__icon-button {
		display: grid;
		width: var(--control-lg);
		height: var(--control-lg);
		place-items: center;
		padding: 0;
		border: 0;
		border-radius: var(--radius-sm);
		background: transparent;
		color: var(--header-icon);
		font-family: var(--font-sans);
		font-size: calc(13px * var(--ui-scale));
		font-weight: 600;
		letter-spacing: 0.04em;
		cursor: default;
	}
	.language-toggle__icon-button:focus-visible {
		outline: var(--focus-width) solid var(--color-focus);
		outline-offset: var(--space-1);
	}
	/* Matches Header's .header__mobile-link rows it sits under; muted and
	   inert until i18n lands. */
	.language-toggle__row {
		display: flex;
		align-items: center;
		gap: var(--space-3);
		width: 100%;
		height: calc(44px * var(--ui-scale));
		padding-inline: calc(24px * var(--ui-scale));
		border: 0;
		border-radius: var(--radius-sm);
		background: transparent;
		color: var(--color-text-muted);
		font-family: var(--font-heading);
		font-size: calc(16px * var(--ui-scale));
		font-weight: 500;
		cursor: default;
	}
	.language-toggle__row:focus-visible {
		outline: var(--focus-width) solid var(--color-focus);
		outline-offset: var(--space-1);
	}
	.language-toggle__row-code {
		width: calc(18px * var(--ui-scale));
		font-family: var(--font-sans);
		font-size: calc(12px * var(--ui-scale));
		font-weight: 600;
		text-align: center;
	}
	.language-toggle__row-soon {
		margin-left: auto;
		font-family: var(--font-sans);
		font-size: calc(12px * var(--ui-scale));
		font-weight: 600;
	}
	.language-toggle__label {
		font-family: var(--font-sans);
		font-size: calc(14px * var(--ui-scale));
		font-weight: 600;
		line-height: calc(20px * var(--ui-scale));
		color: var(--color-text);
		white-space: nowrap;
	}
</style>
