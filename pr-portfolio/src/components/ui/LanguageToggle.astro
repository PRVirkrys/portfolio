---
// Language control, intentionally inert for now — real i18n is a separate,
// much larger piece of work. Shows the language you'd switch TO (EN) and
// does nothing on click so it doesn't look broken while that's pending.
export interface Props {
	/** 'icon': header icon button with a tooltip naming the target language
	 * in that language (pairs with ThemeToggle beside it).
	 * 'row': full-width mobile menu row — the tooltip's text shown inline,
	 * since touch has no hover. */
	variant?: 'icon' | 'row';
}

const { variant = 'icon' } = Astro.props;
---

{variant === 'icon' ? (
	<span class="tooltip-anchor">
		<!-- aria-disabled (not disabled) keeps it focusable so keyboard users
		     still reach the tooltip; it does nothing on click while inert. -->
		<button type="button" class="language-toggle__icon-button" aria-disabled="true" aria-label="View in English (coming soon)" lang="en">EN</button>
		<span class="tooltip tooltip--end" aria-hidden="true" lang="en">View in English · coming soon</span>
	</span>
) : (
	<button type="button" class="language-toggle__row" aria-disabled="true" lang="en">
		<span class="language-toggle__row-code" aria-hidden="true">EN</span>
		View in English
		<span class="language-toggle__row-soon" lang="es">Próximamente</span>
	</button>
)}

<style>
	/* Same footprint as ThemeToggle beside it. */
	.language-toggle__icon-button {
		display: grid;
		width: var(--control-lg);
		height: var(--control-lg);
		place-items: center;
		padding: 0;
		border: 0;
		border-radius: var(--radius-sm);
		background: transparent;
		color: var(--header-icon);
		font-family: var(--font-sans);
		font-size: calc(13px * var(--ui-scale));
		font-weight: 600;
		letter-spacing: 0.04em;
		cursor: default;
	}
	.language-toggle__icon-button:focus-visible {
		outline: var(--focus-width) solid var(--color-focus);
		outline-offset: var(--space-1);
	}
	/* Matches Header's .header__mobile-link rows it sits under; muted and
	   inert until i18n lands. */
	.language-toggle__row {
		display: flex;
		align-items: center;
		gap: var(--space-3);
		width: 100%;
		height: calc(44px * var(--ui-scale));
		padding-inline: calc(24px * var(--ui-scale));
		border: 0;
		border-radius: var(--radius-sm);
		background: transparent;
		color: var(--color-text-muted);
		font-family: var(--font-heading);
		font-size: calc(16px * var(--ui-scale));
		font-weight: 500;
		cursor: default;
	}
	.language-toggle__row:focus-visible {
		outline: var(--focus-width) solid var(--color-focus);
		outline-offset: var(--space-1);
	}
	.language-toggle__row-code {
		width: calc(18px * var(--ui-scale));
		font-family: var(--font-sans);
		font-size: calc(12px * var(--ui-scale));
		font-weight: 600;
		text-align: center;
	}
	.language-toggle__row-soon {
		margin-left: auto;
		font-family: var(--font-sans);
		font-size: calc(12px * var(--ui-scale));
		font-weight: 600;
	}
</style>
