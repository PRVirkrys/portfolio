---
import Logo from './Logo.astro';

export interface Props {
	id: 'lpa' | 'failfast' | 'pelt8' | 'pr';
	name: string;
	logo?: string;
	/** Direct destination: renders a link instead of the panel toggle. */
	href?: string;
}

const { id, name, logo, href } = Astro.props;
const classes = ['work-bubble', `work-bubble--${id}`];
---

{href ? (
	<a class:list={classes} href={href} data-work-id={id} aria-label={`Ver case study de ${name}`}>
		{logo ? <img src={logo} alt="" /> : <Logo class="work-bubble__brand" />}
	</a>
) : (
	<button class:list={classes} type="button" data-work-id={id} aria-controls={`work-panel-${id}`} aria-expanded="false" aria-label={`Explorar experiencia ${name}`}>
		{logo ? <img src={logo} alt="" /> : <Logo class="work-bubble__brand" />}
	</button>
)}

<style>
	.work-bubble { display: grid; width: var(--component-work-bubble-size); height: var(--component-work-bubble-size); place-items: center; flex: 0 0 var(--component-work-bubble-size); overflow: hidden; border: calc(2px * var(--ui-scale)) solid var(--color-neutral-950); border-radius: var(--radius-full); cursor: pointer; transition: transform var(--duration-medium) var(--ease-standard), opacity var(--duration-fast) var(--ease-standard), box-shadow var(--duration-fast) var(--ease-standard); }
	/* Contact shadow — dark theme only, see WorkNavigation.astro's __cta rule. */
	:global(html.dark) .work-bubble { box-shadow: calc(-4px * var(--ui-scale)) 0 calc(2.5px * var(--ui-scale)) rgba(16, 16, 31, 0.25); }
	.work-bubble--lpa { background: #0d35dc; }
	.work-bubble--failfast { background: #ee8089; }
	.work-bubble--pelt8 { background: #062e4a; }
	.work-bubble--pr { background: #100c18; }
	.work-bubble > img { width: 100%; height: 100%; object-fit: contain; border-radius: 0; }
	.work-bubble--lpa > img { width: 73.333%; height: auto; }
	.work-bubble--failfast > img { width: 44%; height: auto; }
	.work-bubble--pelt8 > img { width: 65.333%; height: 65.333%; transform: translate(calc(1px * var(--ui-scale)), calc(1px * var(--ui-scale))); }
	.work-bubble > :global(.work-bubble__brand) { width: 65%; height: auto; }
	.work-bubble:focus-visible { outline: var(--focus-width) solid var(--color-focus); outline-offset: var(--space-1); }
	@media (prefers-reduced-motion: reduce) { .work-bubble { transition: none; } }
</style>
