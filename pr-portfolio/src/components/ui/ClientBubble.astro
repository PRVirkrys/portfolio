---
import { MonitorCloud, PanelsTopLeft, Workflow, Component, CodeXml, Monitor } from '@lucide/astro';
import type { Client } from '../../data/work-navigation';

export interface Props extends Client {}

const ICONS: Record<string, any> = { MonitorCloud, PanelsTopLeft, Workflow, Component, CodeXml, Monitor };

const { name, logo, logos, logoClass, icon, href, surface = 'light' } = Astro.props;
const Tag = href ? 'a' : 'span';
const Icon = icon ? ICONS[icon] : undefined;
---

<Tag class:list={['client-bubble', `client-bubble--${surface}`]} href={href} aria-label={href ? `Ver case study de ${name}` : name} aria-disabled={href ? undefined : 'true'}>
	{Icon ? <Icon /> : logos ? <span class:list={['client-bubble__hedgepilot', logoClass]}>{logos.map((asset) => <img src={asset} alt="" />)}</span> : logo ? <img class={logoClass} src={logo} alt="" /> : <span class="client-bubble__emoji" aria-hidden="true">🪼</span>}
</Tag>

<style>
	.client-bubble { display: grid; position: relative; width: var(--component-work-bubble-size); height: var(--component-work-bubble-size); place-items: center; flex: 0 0 var(--component-work-bubble-size); overflow: hidden; border: var(--border-width) solid var(--color-surface); border-radius: var(--radius-full); box-shadow: 0 calc(-4px * var(--ui-scale)) calc(2px * var(--ui-scale)) rgba(0, 0, 0, 0.25); transition: transform var(--duration-medium) var(--ease-standard), opacity var(--duration-fast) var(--ease-standard); }
	.client-bubble--light { background: #fff; }
	.client-bubble--cyan { background: #73ebff; }
	.client-bubble--navy { background: #07152e; }
	.client-bubble--teal { background: #45c9b2; border-color: #062e4a; }
	.client-bubble--deep { background: #062e4a; border-color: #062e4a; }
	.client-bubble--asset { border: 0; background: transparent; }
	.client-bubble :global(svg) { width: calc(31.5px * var(--ui-scale)); height: calc(31.5px * var(--ui-scale)); color: var(--color-base-white); }
	.client-bubble img { max-width: none; height: auto; border-radius: 0; }
	.client-bubble__logo--lms { width: calc(45px * var(--ui-scale)); }
	.client-bubble__logo--base { width: calc(42px * var(--ui-scale)); }
	.client-bubble__logo--uoc { width: calc(54px * var(--ui-scale)); }
	.client-bubble__logo--asset { width: 100%; height: 100%; object-fit: cover; }
	.client-bubble__logo--barca { width: calc(41px * var(--ui-scale)); }
	.client-bubble__logo--timechef { width: calc(50px * var(--ui-scale)); border-radius: var(--radius-full); }
	.client-bubble__logo--capmatix { width: calc(57px * var(--ui-scale)); }
	.client-bubble__logo--hedgepilot { width: calc(54px * var(--ui-scale)); }
	.client-bubble__hedgepilot { position: relative; width: calc(54px * var(--ui-scale)); height: calc(10px * var(--ui-scale)); }
	.client-bubble__hedgepilot img { position: absolute; height: auto; }
	.client-bubble__hedgepilot img:nth-child(1) { bottom: 0; left: 20.31%; width: 48.03%; }
	.client-bubble__hedgepilot img:nth-child(2) { top: 12.66%; right: 0; width: 29.43%; }
	.client-bubble__hedgepilot img:nth-child(3) { top: 0; left: 0; width: 16.36%; }
	.client-bubble__emoji { font-size: calc(36px * var(--ui-scale)); line-height: calc(48px * var(--ui-scale)); }
	.client-bubble[href]:focus-visible { outline: var(--focus-width) solid var(--color-focus); outline-offset: var(--space-1); }
	@media (prefers-reduced-motion: reduce) { .client-bubble { transition: none; } }
</style>
