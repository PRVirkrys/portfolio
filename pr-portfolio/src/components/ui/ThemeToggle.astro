---
// Figma: PR Brand (DS) → ThemeToggle (node 15705:1179), used inside the
// header's "Language menu" panel (node 16067:68076). Functional: flips
// `.dark` on <html> and persists the choice — see BaseHead.astro's blocking
// init script for how the saved value is applied before first paint.
import { Lightbulb } from '@lucide/astro';

export interface Props {
	label?: string;
	showLabel?: boolean;
	/** 'icon': a plain icon button (header bar) — same bulb and behavior,
	 * without the switch track. */
	variant?: 'switch' | 'icon';
}

const { label = 'Encender las luces', showLabel = true, variant = 'switch' } = Astro.props;
---

{variant === 'icon' ? (
	<span class="theme-toggle theme-toggle--icon tooltip-anchor">
		<button type="button" class="theme-toggle__control theme-toggle__control--icon" role="switch" aria-checked="true" aria-label="Encender las luces">
			<Lightbulb class="theme-toggle__icon" aria-hidden="true" />
		</button>
		<!-- Visual-only: the button's aria-label already says the same thing. -->
		<span class="tooltip theme-toggle__tooltip" data-theme-label aria-hidden="true">Encender las luces</span>
	</span>
) : (
<div class="theme-toggle">
	<button type="button" class="theme-toggle__control" role="switch" aria-checked="true" aria-label="Encender las luces">
		<span class="theme-toggle__track">
			<!-- Only the thumb carries an icon; the track stays empty. The same
			     bulb lights up (yellow) in light theme and goes dark in dark. -->
			<span class="theme-toggle__thumb" aria-hidden="true">
				<Lightbulb class="theme-toggle__icon" />
			</span>
		</span>
	</button>
	{showLabel && <span class="theme-toggle__label" data-theme-label>{label}</span>}
</div>
)}

<style>
	.theme-toggle {
		display: flex;
		align-items: center;
		gap: var(--space-2);
		height: calc(44px * var(--ui-scale));
	}
	.theme-toggle__control {
		display: block;
		flex-shrink: 0;
		padding: calc(6px * var(--ui-scale)) 0;
		border: 0;
		background: transparent;
		cursor: pointer;
	}
	.theme-toggle__track {
		position: relative;
		display: block;
		width: calc(52px * var(--ui-scale));
		height: calc(32px * var(--ui-scale));
		border: var(--border-width) solid var(--color-border);
		border-radius: var(--radius-full);
		background: var(--color-surface-raised);
	}
	.theme-toggle__thumb {
		position: absolute;
		top: calc(3px * var(--ui-scale));
		left: calc(3px * var(--ui-scale));
		width: calc(24px * var(--ui-scale));
		height: calc(24px * var(--ui-scale));
		display: grid;
		place-items: center;
		border-radius: var(--radius-full);
		/* Border, not just the shadow: the thumb is always pure white and the
		   light-theme track is #fafafb (--color-surface-raised) — near enough
		   to white that with light theme's shadows now flat (none), the two
		   were indistinguishable. The border is what actually separates them;
		   the shadow below is extra depth on top of that, not the only cue. */
		border: var(--border-width) solid var(--color-border);
		background: var(--color-base-white);
		box-shadow: var(--elevation-button-adaptive);
		transition: transform var(--duration-fast) var(--ease-standard);
	}
	/* Dark is the "on" position — thumb slides to the right. */
	.theme-toggle__control[aria-checked='true'] .theme-toggle__thumb {
		transform: translateX(calc(20px * var(--ui-scale)));
	}
	/* Icon riding inside the thumb crossfades to match whichever side it's
	   currently parked on. */
	.theme-toggle__icon {
		width: calc(14px * var(--ui-scale));
		height: calc(14px * var(--ui-scale));
		/* The thumb is white in both themes, so its icon needs a fixed dark
		   ink — --color-text-inverse flips to white in light theme. */
		color: var(--color-neutral-950);
		fill: transparent;
		transition:
			fill var(--duration-fast) var(--ease-standard),
			filter var(--duration-fast) var(--ease-standard);
	}
	/* Light theme = lights on: the bulb glows with yellow glass and a soft
	   halo. Stroke keeps its ink so the shape still reads on the white thumb. */
	.theme-toggle__control:not([aria-checked='true']) .theme-toggle__icon {
		fill: var(--color-brand-yellow-500);
		filter: drop-shadow(0 0 3px var(--color-brand-yellow-500));
	}
	.theme-toggle__control:focus-visible {
		outline: var(--focus-width) solid var(--color-focus);
		outline-offset: var(--space-1);
		border-radius: var(--radius-full);
	}
	/* Icon variant — same footprint as the header's other icon buttons. */
	.theme-toggle__control--icon {
		display: grid;
		width: var(--control-lg);
		height: var(--control-lg);
		place-items: center;
		padding: 0;
		border-radius: var(--radius-sm);
	}
	.theme-toggle__control--icon:hover {
		background: var(--color-action-secondary-bg-hover);
	}
	.theme-toggle__control--icon:focus-visible {
		border-radius: var(--radius-sm);
	}
	/* No white thumb behind it here, so the ink follows the header's. */
	.theme-toggle__control--icon .theme-toggle__icon {
		width: var(--icon-lg);
		height: var(--icon-lg);
		color: var(--header-icon);
	}
	.theme-toggle__label {
		font-family: var(--font-sans);
		font-size: calc(14px * var(--ui-scale));
		font-weight: 600;
		line-height: calc(20px * var(--ui-scale));
		color: var(--color-text);
		white-space: nowrap;
	}
	.theme-toggle--icon {
		height: auto;
	}
	/* Already open when the theme flips (cursor still on the button): the
	   new text pops in instead of just swapping. Class set by the script. */
	.theme-toggle__tooltip.is-swapping {
		animation: theme-tooltip-swap var(--duration-medium) var(--ease-standard);
	}
	@keyframes theme-tooltip-swap {
		from {
			transform: translate(var(--tooltip-x), 0) scale(0.9);
		}
	}
	@media (prefers-reduced-motion: reduce) {
		.theme-toggle__tooltip.is-swapping {
			animation: none;
		}
		.theme-toggle__thumb,
		.theme-toggle__icon {
			transition: none;
		}
	}
</style>

<!-- "Light switch" reveal: the new theme is a View Transition snapshot whose
     clip-path circle grows out of the toggle (see the script below). Turn off
     the default root crossfade so only that circle is visible. Global because
     view-transition pseudo-elements live on <html>, outside component scope. -->
<style is:global>
	::view-transition-old(root),
	::view-transition-new(root) {
		animation: none;
		mix-blend-mode: normal;
	}
</style>

<script>
	const controls = document.querySelectorAll<HTMLElement>('.theme-toggle__control');

	// Every toggle on the page (desktop settings menu + mobile drawer) mirrors
	// the same <html> class, so they all resync after any one is clicked.
	function syncAll() {
		const isDark = document.documentElement.classList.contains('dark');
		// Label names the action, like a light switch: dark → "turn them on".
		const text = isDark ? 'Encender las luces' : 'Apagar las luces';
		controls.forEach((control) => {
			control.setAttribute('aria-checked', String(isDark));
			control.setAttribute('aria-label', text);
			const label = control.closest('.theme-toggle')?.querySelector<HTMLElement>('[data-theme-label]');
			if (label && label.textContent !== text) {
				label.textContent = text;
				// Restart the swap pop (tooltip variant only; no-op elsewhere).
				label.classList.remove('is-swapping');
				void label.offsetWidth;
				label.classList.add('is-swapping');
			}
		});
	}

	function applyTheme() {
		const isDark = document.documentElement.classList.toggle('dark');
		try {
			localStorage.setItem('theme', isDark ? 'dark' : 'light');
		} catch {
			// Storage can be unavailable (private mode, disabled) — the
			// toggle still works for the current page view either way.
		}
		syncAll();
	}

	function toggleFrom(control: HTMLElement) {
		const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
		if (!document.startViewTransition || reduceMotion) {
			applyTheme();
			return;
		}
		// Circle grows from the switch's center until it covers the farthest
		// viewport corner, like light spreading from where it was flipped.
		const rect = control.getBoundingClientRect();
		const x = rect.left + rect.width / 2;
		const y = rect.top + rect.height / 2;
		const radius = Math.hypot(Math.max(x, innerWidth - x), Math.max(y, innerHeight - y));
		const transition = document.startViewTransition(applyTheme);
		transition.ready.then(() => {
			document.documentElement.animate(
				{ clipPath: [`circle(0px at ${x}px ${y}px)`, `circle(${radius}px at ${x}px ${y}px)`] },
				{ duration: 700, easing: 'cubic-bezier(0.4, 0, 0.2, 1)', pseudoElement: '::view-transition-new(root)' },
			);
		});
	}

	syncAll();
	controls.forEach((control) => control.addEventListener('click', () => toggleFrom(control)));
</script>
