---
// Theme icon button (header bar + mobile bar): a lightbulb that's lit
// (yellow) in light theme and plain in dark. Functional: flips `.dark` on
// <html> and persists the choice — see BaseHead.astro's blocking init script
// for how the saved value is applied before first paint.
import { Lightbulb } from '@lucide/astro';
---

<span class="theme-toggle tooltip-anchor">
	<button type="button" class="theme-toggle__control" role="switch" aria-checked="true" aria-label="Encender las luces">
		<Lightbulb class="theme-toggle__icon" aria-hidden="true" />
	</button>
	<!-- Visual-only: the button's aria-label already says the same thing. -->
	<span class="tooltip theme-toggle__tooltip" aria-hidden="true">Encender las luces</span>
</span>

<style>
	/* Same footprint as the header's other icon buttons. */
	.theme-toggle__control {
		display: grid;
		width: var(--control-lg);
		height: var(--control-lg);
		place-items: center;
		padding: 0;
		border: 0;
		border-radius: var(--radius-sm);
		background: transparent;
		cursor: pointer;
	}
	/* Hover-capable pointers only: on touch, :hover sticks after a tap. */
	@media (hover: hover) {
		.theme-toggle__control:hover {
			background: var(--color-action-secondary-bg-hover);
		}
	}
	.theme-toggle__control:focus-visible {
		outline: var(--focus-width) solid var(--color-focus);
		outline-offset: var(--space-1);
	}
	.theme-toggle__icon {
		width: var(--icon-lg);
		height: var(--icon-lg);
		color: var(--header-icon);
		fill: transparent;
		transition:
			fill var(--duration-fast) var(--ease-standard),
			filter var(--duration-fast) var(--ease-standard);
	}
	/* Light theme = lights on: the bulb glows with yellow glass and a soft
	   halo; the stroke keeps its ink so the shape still reads. */
	.theme-toggle__control:not([aria-checked='true']) .theme-toggle__icon {
		fill: var(--color-brand-yellow-500);
		filter: drop-shadow(0 0 3px var(--color-brand-yellow-500));
	}
	/* Already open when the theme flips (cursor still on the button): the
	   new text pops in instead of just swapping. Class set by the script. */
	.theme-toggle__tooltip.is-swapping {
		animation: theme-tooltip-swap var(--duration-medium) var(--ease-standard);
	}
	@keyframes theme-tooltip-swap {
		from {
			transform: translate(var(--tooltip-x), 0) scale(0.9);
		}
	}
	@media (prefers-reduced-motion: reduce) {
		.theme-toggle__tooltip.is-swapping {
			animation: none;
		}
		.theme-toggle__icon {
			transition: none;
		}
	}
</style>

<!-- "Light switch" reveal: the new theme is a View Transition snapshot whose
     clip-path circle grows out of the toggle (see the script below). Turn off
     the default root crossfade so only that circle is visible. Global because
     view-transition pseudo-elements live on <html>, outside component scope. -->
<style is:global>
	::view-transition-old(root),
	::view-transition-new(root) {
		animation: none;
		mix-blend-mode: normal;
	}
</style>

<script>
	const controls = document.querySelectorAll<HTMLElement>('.theme-toggle__control');

	// Every toggle on the page (desktop header + mobile bar) mirrors the same
	// <html> class, so they all resync after any one is clicked.
	function syncAll() {
		const isDark = document.documentElement.classList.contains('dark');
		// Label names the action, like a light switch: dark → "turn them on".
		const text = isDark ? 'Encender las luces' : 'Apagar las luces';
		controls.forEach((control) => {
			control.setAttribute('aria-checked', String(isDark));
			control.setAttribute('aria-label', text);
			const label = control.closest('.theme-toggle')?.querySelector<HTMLElement>('.theme-toggle__tooltip');
			if (label && label.textContent !== text) {
				label.textContent = text;
				// Restart the swap pop.
				label.classList.remove('is-swapping');
				void label.offsetWidth;
				label.classList.add('is-swapping');
			}
		});
	}

	function applyTheme() {
		const isDark = document.documentElement.classList.toggle('dark');
		try {
			localStorage.setItem('theme', isDark ? 'dark' : 'light');
		} catch {
			// Storage can be unavailable (private mode, disabled) — the
			// toggle still works for the current page view either way.
		}
		syncAll();
	}

	function toggleFrom(control: HTMLElement) {
		const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
		if (!document.startViewTransition || reduceMotion) {
			applyTheme();
			return;
		}
		// Circle grows from the button's center until it covers the farthest
		// viewport corner, like light spreading from where it was flipped.
		const rect = control.getBoundingClientRect();
		const x = rect.left + rect.width / 2;
		const y = rect.top + rect.height / 2;
		const radius = Math.hypot(Math.max(x, innerWidth - x), Math.max(y, innerHeight - y));
		const transition = document.startViewTransition(applyTheme);
		transition.ready.then(() => {
			document.documentElement.animate(
				{ clipPath: [`circle(0px at ${x}px ${y}px)`, `circle(${radius}px at ${x}px ${y}px)`] },
				{ duration: 700, easing: 'cubic-bezier(0.4, 0, 0.2, 1)', pseudoElement: '::view-transition-new(root)' },
			);
		});
	}

	syncAll();
	controls.forEach((control) => control.addEventListener('click', () => toggleFrom(control)));
</script>
