---
import { ArrowRight } from '@lucide/astro';
import { works } from '../data/work-navigation';
import ClientBubble from './ui/ClientBubble.astro';
import Tag from './ui/Tag.astro';
import WorkBubble from './ui/WorkBubble.astro';
---

<div class="work-navigation">
	<div class="work-navigation__overlay" aria-hidden="true"></div>
	<nav class="work-navigation__control" aria-label="Experiencia profesional">
		<div class="work-navigation__bubbles">
			{works.map((work) => <WorkBubble id={work.id} name={work.name} logo={work.logo} />)}
		</div>
		{works.map((work) => (
			<section class="work-panel" id={`work-panel-${work.id}`} aria-label={`Experiencia ${work.name}`} hidden>
				{work.clients && <div class="work-panel__clients">{work.clients.map((client) => (
					<div class="work-panel__client">
						<ClientBubble {...client} />
						<Tag category="Neutral" size="md" class="work-panel__label-tag">{client.label ?? client.name}</Tag>
					</div>
				))}</div>}
				{work.ctaHref
					? <a class="work-panel__cta" href={work.ctaHref} aria-label={work.ctaLabel}><ArrowRight /><Tag category="Neutral" size="md" class="work-panel__label-tag">See all</Tag></a>
					: <span class="work-panel__cta" aria-disabled="true" aria-label={work.ctaLabel}><ArrowRight /><Tag category="Neutral" size="md" class="work-panel__label-tag">See all</Tag></span>}
			</section>
		))}
	</nav>
</div>

<style>
	.work-navigation { position: relative; z-index: 1; pointer-events: none; }
	.work-navigation__control { position: relative; pointer-events: auto; }
	.work-navigation__overlay { position: fixed; inset: 0; z-index: 45; pointer-events: none; background: linear-gradient(to top, rgba(16, 16, 31, 0.2), rgba(69, 69, 133, 0.2)); opacity: 0; transition: opacity var(--duration-medium) var(--ease-standard); }
	.work-navigation__overlay.is-visible { opacity: 1; pointer-events: auto; }
	:global(.header:has(.work-panel:not([hidden]))) { z-index: 50; }
	@supports (backdrop-filter: blur(5.5px)) { .work-navigation__overlay.is-visible { backdrop-filter: blur(5.5px); } }
	.work-navigation__bubbles { display: flex; align-items: center; }
	.work-navigation__bubbles :global(.work-bubble) { margin-right: calc(var(--space-4) * -1 - 1px); }
	.work-navigation__bubbles :global(.work-bubble:last-child) { margin-right: 0; }
	.work-navigation:is(.is-hovering, .is-engaged) .work-navigation__bubbles :global(.work-bubble:not(.is-active)) { opacity: calc(var(--opacity-disabled) / 100); }
	.work-navigation__bubbles :global(.work-bubble.is-active) { z-index: 3; transform: scale(1.2); }
	.work-navigation__bubbles :global(.work-bubble.is-active + .work-bubble) { z-index: 4; }
	.work-panel { --wb-step: calc(var(--component-work-bubble-size) - var(--space-4) - 1px); position: absolute; top: calc(var(--space-2) * -1); z-index: 2; width: auto; min-width: calc(var(--component-work-bubble-size) + var(--space-2) * 2); overflow: visible; display: flex; flex-direction: column; align-items: center; gap: var(--space-6); padding: var(--space-2); padding-top: calc(var(--component-work-bubble-size) + var(--space-6) + var(--space-2)); background: var(--color-neutral-950); border-radius: var(--radius-full); }
	.work-panel[hidden] { display: none; }
	#work-panel-lpa { left: calc(0 * var(--wb-step) - var(--space-2)); }
	#work-panel-failfast { left: calc(1 * var(--wb-step) - var(--space-2)); }
	#work-panel-pelt8 { left: calc(2 * var(--wb-step) - var(--space-2)); }
	#work-panel-pr { left: calc(3 * var(--wb-step) - var(--space-2)); }
	.work-panel__clients { display: flex; flex-direction: column; align-items: center; gap: var(--space-6); overflow: visible; }
	.work-panel__clients:hover :global(.client-bubble) { opacity: calc(var(--opacity-disabled) / 100); }
	.work-panel__clients :global(.client-bubble:hover) { z-index: 1; opacity: 1; transform: scale(1.2); }
	.work-panel__client { position: relative; display: flex; }
	:is(.work-panel__client, .work-panel__cta) :global(.work-panel__label-tag) { --tag-color: var(--color-base-white); position: absolute; top: 50%; left: calc(100% + var(--space-3)); transform: translateY(-50%); opacity: 0; pointer-events: none; text-transform: uppercase; letter-spacing: 1.4px; white-space: nowrap; transition: opacity var(--duration-fast) var(--ease-standard); }
	:is(.work-panel__client, .work-panel__cta):hover :global(.work-panel__label-tag), :is(.work-panel__client, .work-panel__cta):focus-within :global(.work-panel__label-tag) { opacity: 1; }
	.work-panel__cta { display: flex; width: var(--component-work-bubble-size); height: var(--component-work-bubble-size); flex: 0 0 auto; align-items: center; justify-content: center; border: var(--border-width) solid var(--color-base-white); border-radius: var(--radius-full); background: var(--color-neutral-950); box-shadow: 0 -4px 2px rgba(0, 0, 0, 0.25); color: var(--color-base-white); }
	.work-panel__cta { position: relative; }
	.work-panel__cta :global(svg) { width: var(--icon-lg); height: var(--icon-lg); transition: transform var(--duration-fast) var(--ease-standard); }
	.work-panel__cta:hover :global(svg), .work-panel__cta:focus-visible :global(svg) { transform: translateX(25%); }
	@media (prefers-reduced-motion: reduce) { .work-navigation__overlay { transition: none; backdrop-filter: none; } .work-panel__cta :global(svg) { transition: none; } .work-panel__cta:hover :global(svg) { transform: none; } }
</style>

<script>
	const navigation = document.querySelector<HTMLElement>('.work-navigation');
	if (navigation) {
		const bubbles = Array.from(navigation.querySelectorAll<HTMLButtonElement>('.work-bubble'));
		const panels = Array.from(navigation.querySelectorAll<HTMLElement>('.work-panel'));
		const overlay = navigation.querySelector<HTMLElement>('.work-navigation__overlay');
		if (overlay) document.body.appendChild(overlay);
		let activeId: string | undefined;
		const getWorkId = (bubble: HTMLButtonElement) => bubble.getAttribute('aria-controls')?.replace('work-panel-', '');
		const setActive = (id?: string) => {
			activeId = id;
			navigation.classList.toggle('is-engaged', Boolean(id));
			overlay?.classList.toggle('is-visible', Boolean(id));
			bubbles.forEach((bubble) => {
				const active = getWorkId(bubble) === id;
				bubble.classList.toggle('is-active', active);
				bubble.setAttribute('aria-expanded', String(active));
			});
			panels.forEach((panel) => { panel.hidden = panel.id !== `work-panel-${id}`; });
		};
		const setHovered = (id?: string) => {
			navigation.classList.toggle('is-hovering', Boolean(id));
			if (!activeId) bubbles.forEach((bubble) => bubble.classList.toggle('is-active', getWorkId(bubble) === id));
			navigation.classList.toggle('is-engaged', Boolean(id || activeId));
		};
		bubbles.forEach((bubble) => {
			bubble.addEventListener('click', () => { const id = getWorkId(bubble); setActive(activeId === id ? undefined : id); });
			bubble.addEventListener('pointerenter', () => setHovered(getWorkId(bubble)));
			bubble.addEventListener('focus', () => setHovered(getWorkId(bubble)));
		});
		navigation.addEventListener('pointerleave', () => setHovered());
		navigation.addEventListener('focusout', (event) => { if (!navigation.contains(event.relatedTarget as Node)) setHovered(); });
		document.addEventListener('pointerdown', (event) => { if (activeId && !navigation.contains(event.target as Node)) setActive(); });
		document.addEventListener('keydown', (event) => { if (event.key === 'Escape' && activeId) { const previousId = activeId; setActive(); bubbles.find((bubble) => getWorkId(bubble) === previousId)?.focus(); } });
		navigation.addEventListener('click', (event) => { if ((event.target as Element).closest('a[href]')) setActive(); });
		overlay?.addEventListener('click', () => setActive());
	}
</script>
