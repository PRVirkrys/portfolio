---
import Logo from './ui/Logo.astro';
import { BriefcaseBusiness, CircleUserRound, FileUser, Send, Mail } from '@lucide/astro';
import { iconUrl } from '../lib/icons';

const pathname = Astro.url.pathname;
const navigation = [
	{ label: 'Work', href: '/', Icon: BriefcaseBusiness },
	{ label: 'About', href: '/about', Icon: CircleUserRound },
	{ label: 'CV', href: '/cv', Icon: FileUser },
	{ label: 'Contacto', href: '/contacto', Icon: Send },
];
const isActive = (href: string) => (href === '/' ? pathname === '/' || pathname.startsWith('/blog') : pathname === href);
---

<aside class="sidebar">
	<a class="sidebar__brand" href="/" aria-label="Inicio"><Logo class="sidebar__logo" /></a>
	<div class="sidebar__divider"></div>
	<nav class="sidebar__navigation" aria-label="Navegación principal">
		{navigation.map(({ label, href, Icon }) => {
			const active = isActive(href);
			return <a class:list={['sidebar__item', { 'sidebar__item--active': active }]} href={href} aria-current={active ? 'page' : undefined}><span class="sidebar__icon"><Icon /></span><span>{label}</span></a>;
		})}
	</nav>
	<div class="sidebar__spacer"></div>
	<div class="sidebar__divider"></div>
	<div class="sidebar__social" aria-label="Canales de contacto">
		<a href="mailto:bypaularodas@gmail.com" aria-label="Enviar correo a Paula Rodas"><Mail /></a>
		<a href="https://github.com/PRVirkrys" target="_blank" rel="noreferrer" aria-label="Abrir GitHub de Paula Rodas"><img src={iconUrl('github.svg')} alt="" /></a>
		<a href="https://www.linkedin.com/in/paularodas/" target="_blank" rel="noreferrer" aria-label="Abrir LinkedIn de Paula Rodas"><img src={iconUrl('linkedin.svg')} alt="" /></a>
	</div>
</aside>

<style>
	.sidebar { box-sizing: border-box; display: flex; position: fixed; inset: 0 auto 0 0; z-index: 40; width: var(--component-sidebar-width); min-height: 100dvh; flex-direction: column; align-items: center; gap: var(--space-6); padding: var(--space-4); background: var(--sidebar-surface); border-right: var(--border-width) solid var(--sidebar-border); }
	.sidebar__brand { display: grid; width: 48px; height: 48px; place-items: center; }
	.sidebar__brand:hover { color: inherit; }
	.sidebar__logo { width: 40px; height: 35px; }
	.sidebar__divider { width: 48px; height: var(--border-width); background: var(--sidebar-divider); }
	.sidebar__navigation, .sidebar__social { display: flex; width: 80px; flex-direction: column; gap: var(--space-3); }
	.sidebar__item { display: flex; width: 80px; height: 80px; flex-direction: column; align-items: center; justify-content: center; gap: var(--space-1); border-radius: var(--radius-lg); color: var(--sidebar-item-text-default); font-family: var(--typography-ui-link-md-font-family); font-size: 12px; font-weight: 500; line-height: 18px; text-decoration: none; transition: background-color var(--duration-fast) var(--ease-standard), color var(--duration-fast) var(--ease-standard); }
	.sidebar__icon { display: grid; width: 46px; height: 46px; place-items: center; border-radius: var(--radius-md); }
	.sidebar__icon :global(svg) { width: 22px; height: 22px; }
	.sidebar__item:hover { color: var(--sidebar-item-text-default); }
	.sidebar__item:hover .sidebar__icon { background: var(--color-action-secondary-bg-hover); }
	.sidebar__item--active { color: var(--sidebar-item-text-active); }
	.sidebar__item--active .sidebar__icon { background: var(--sidebar-item-icon-surface-active); }
	.sidebar__item:focus-visible, .sidebar__social a:focus-visible { outline: var(--focus-width) solid var(--color-focus); outline-offset: var(--space-1); }
	.sidebar__spacer { flex: 1; min-height: var(--space-4); }
	.sidebar__social { align-items: center; }
	.sidebar__social a { display: grid; width: 80px; height: 40px; place-items: center; border-radius: var(--radius-lg); color: var(--color-base-white); }
	.sidebar__social :global(svg), .sidebar__social img { width: 20px; height: 20px; }
	.sidebar__social a:hover { background: var(--color-action-secondary-bg-hover); }
	@media (max-width: 839px) { .sidebar { inset: auto 0 0 0; width: 100%; min-height: auto; flex-direction: row; justify-content: center; gap: 0; padding: var(--space-2); border-top: var(--border-width) solid var(--sidebar-border); border-right: 0; } .sidebar__brand, .sidebar__divider, .sidebar__spacer, .sidebar__social { display: none; } .sidebar__navigation { width: min(100%, 480px); flex-direction: row; justify-content: space-between; gap: 0; } .sidebar__item { width: 25%; height: 68px; font-size: 11px; } .sidebar__icon { width: 40px; height: 40px; } .sidebar__icon :global(svg) { width: 20px; height: 20px; } }
</style>
