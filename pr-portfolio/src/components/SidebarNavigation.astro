---
import Logo from './ui/Logo.astro';
import { House, BriefcaseBusiness, CircleUserRound, FileUser, Send, Mail } from '@lucide/astro';
import { iconUrl } from '../lib/icons';
import { withBase } from '../lib/url';

const pathname = Astro.url.pathname;
const navigation = [
	{ label: 'Home', href: withBase('/'), Icon: House },
	{ label: 'Work', href: withBase('/work'), Icon: BriefcaseBusiness },
	{ label: 'About', href: withBase('/about'), Icon: CircleUserRound },
	{ label: 'CV', href: withBase('/cv'), Icon: FileUser },
	{ label: 'Contacto', href: withBase('/contacto'), Icon: Send },
];
const isActive = (href: string) => (href === withBase('/') ? pathname === withBase('/') : pathname === href || pathname.startsWith(`${href}/`));
---

<aside class="sidebar">
	<div class="sidebar__brand-block">
		<a class="sidebar__brand" href={withBase('/')} aria-label="Inicio"><Logo class="sidebar__logo" /></a>
	</div>
	<nav class="sidebar__navigation" aria-label="Navegación principal">
		{navigation.map(({ label, href, Icon }) => {
			const active = isActive(href);
			return <a class:list={['sidebar__item', { 'sidebar__item--active': active }]} href={href} aria-current={active ? 'page' : undefined}><span class="sidebar__icon"><Icon /></span><span>{label}</span></a>;
		})}
	</nav>
	<div class="sidebar__spacer"></div>
	<div class="sidebar__divider"></div>
	<div class="sidebar__social" aria-label="Canales de contacto">
		<a href="mailto:bypaularodas@gmail.com" aria-label="Enviar correo a Paula Rodas"><Mail /></a>
		<a href="https://github.com/PRVirkrys" target="_blank" rel="noreferrer" aria-label="Abrir GitHub de Paula Rodas"><img src={iconUrl('github.svg')} alt="" /></a>
		<a href="https://www.linkedin.com/in/paularodas/" target="_blank" rel="noreferrer" aria-label="Abrir LinkedIn de Paula Rodas"><img src={iconUrl('linkedin.svg')} alt="" /></a>
	</div>
</aside>

<style>
	.sidebar { box-sizing: border-box; display: flex; position: fixed; inset: 0 auto 0 0; z-index: 40; width: var(--component-sidebar-width); min-height: 100dvh; flex-direction: column; align-items: center; gap: var(--space-6); padding: var(--space-4); background: var(--sidebar-surface); border-right: var(--border-width) solid var(--sidebar-border); }
	/* Locked to the same height as the fixed header bar (see
	   --component-header-height-desktop in Header.astro) and bled full width
	   *and* pulled up to y0 via negative margins (cancelling .sidebar's own
	   padding on all three sides) so this border-bottom lands exactly level
	   with the header's border-bottom — both start flush at the viewport top,
	   drawing one continuous seam across the page. */
	.sidebar__brand-block { display: flex; flex-shrink: 0; align-items: center; justify-content: center; width: calc(100% + var(--space-4) * 2); height: var(--component-header-height-desktop); margin-top: calc(var(--space-4) * -1); margin-inline: calc(var(--space-4) * -1); border-bottom: var(--border-width) solid var(--sidebar-divider); }
	.sidebar__brand { display: grid; width: calc(48px * var(--ui-scale)); height: calc(48px * var(--ui-scale)); place-items: center; }
	.sidebar__brand:hover { color: inherit; }
	.sidebar__logo { width: calc(40px * var(--ui-scale)); height: calc(35px * var(--ui-scale)); }
	.sidebar__divider { width: calc(48px * var(--ui-scale)); height: var(--border-width); background: var(--sidebar-divider); }
	.sidebar__navigation, .sidebar__social { display: flex; width: calc(80px * var(--ui-scale)); flex-direction: column; gap: var(--space-3); }
	.sidebar__item { display: flex; width: calc(80px * var(--ui-scale)); height: calc(80px * var(--ui-scale)); flex-direction: column; align-items: center; justify-content: center; gap: var(--space-1); border-radius: var(--radius-lg); color: var(--sidebar-item-text-default); font-family: var(--typography-ui-link-md-font-family); font-size: calc(12px * var(--ui-scale)); font-weight: 500; line-height: calc(18px * var(--ui-scale)); text-decoration: none; transition: background-color var(--duration-fast) var(--ease-standard), color var(--duration-fast) var(--ease-standard); }
	.sidebar__icon { display: grid; width: calc(46px * var(--ui-scale)); height: calc(46px * var(--ui-scale)); place-items: center; border-radius: var(--radius-md); }
	.sidebar__icon :global(svg) { width: calc(22px * var(--ui-scale)); height: calc(22px * var(--ui-scale)); }
	.sidebar__item:hover { color: var(--sidebar-item-text-default); }
	.sidebar__item:hover .sidebar__icon { background: var(--color-action-secondary-bg-hover); }
	.sidebar__item--active { color: var(--sidebar-item-text-active); }
	.sidebar__item--active .sidebar__icon { background: var(--sidebar-item-icon-surface-active); }
	.sidebar__item:focus-visible, .sidebar__social a:focus-visible { outline: var(--focus-width) solid var(--color-focus); outline-offset: var(--space-1); }
	.sidebar__spacer { flex: 1; min-height: var(--space-4); }
	.sidebar__social { align-items: center; }
	.sidebar__social a { display: grid; width: calc(80px * var(--ui-scale)); height: calc(40px * var(--ui-scale)); place-items: center; border-radius: var(--radius-lg); color: var(--header-icon); }
	.sidebar__social :global(svg), .sidebar__social img { width: calc(20px * var(--ui-scale)); height: calc(20px * var(--ui-scale)); }
	/* The GitHub/LinkedIn marks are flat-white .svg files loaded via <img>,
	   so they can't pick up `color` like the Mail icon (inline SVG) does —
	   invert them in light theme instead of baking a second dark asset. */
	:global(html:not(.dark)) .sidebar__social img { filter: invert(1); }
	.sidebar__social a:hover { background: var(--color-action-secondary-bg-hover); }
	@media (max-width: 839px) { .sidebar { inset: auto 0 0 0; width: 100%; min-height: auto; flex-direction: row; justify-content: center; gap: 0; padding: var(--space-2); border-top: var(--border-width) solid var(--sidebar-border); border-right: 0; } .sidebar__brand-block, .sidebar__divider, .sidebar__spacer, .sidebar__social { display: none; } .sidebar__navigation { width: min(100%, calc(600px * var(--ui-scale))); flex-direction: row; justify-content: space-between; gap: 0; } .sidebar__item { width: 20%; height: calc(68px * var(--ui-scale)); font-size: calc(11px * var(--ui-scale)); } .sidebar__icon { width: calc(40px * var(--ui-scale)); height: calc(40px * var(--ui-scale)); } .sidebar__icon :global(svg) { width: calc(20px * var(--ui-scale)); height: calc(20px * var(--ui-scale)); } }
</style>
