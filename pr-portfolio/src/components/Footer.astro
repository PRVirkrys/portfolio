---
// Figma: PR Brand (DS) → Footer (node 15984:183946)
import { iconUrl } from '../lib/icons';
---

<footer class="footer">
	<span class="footer__item">
		<span>Made in Barcelona</span>
		<img class="footer__flag" src={iconUrl('flag-spain.svg')} alt="" width="32" height="32" />
	</span>
	<span class="footer__sep" aria-hidden="true">·</span>
	<span class="footer__item">
		<span>By an Ecuadorian</span>
		<img class="footer__flag" src={iconUrl('flag-ecuador.svg')} alt="" width="32" height="32" />
	</span>
	<span class="footer__sep" aria-hidden="true">·</span>
	<span class="footer__item">
		<span>Emotional support by Flash</span>
		<span class="footer__dog" role="img" aria-label="perro">🐶</span>
	</span>
</footer>

<style>
	.footer {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: flex-end;
		gap: var(--space-6);
		padding: calc(10px * var(--ui-scale)) var(--gutter-desktop);
		background: var(--color-bg);
		border-top: var(--border-width) solid var(--color-border);
		color: color-mix(in srgb, var(--color-text) 90%, transparent);
		font-family: var(--font-sans);
		font-size: calc(12px * var(--ui-scale));
		font-weight: 400;
		letter-spacing: calc(1px * var(--ui-scale));
		text-align: center;
	}
	.footer__item { display: flex; align-items: center; gap: var(--space-3); white-space: nowrap; }
	.footer__flag { display: block; width: calc(24px * var(--ui-scale)); height: calc(24px * var(--ui-scale)); }
	.footer__sep { font-size: calc(24px * var(--ui-scale)); line-height: 1.75; }
	.footer__dog { font-size: calc(23px * var(--ui-scale)); line-height: 1; }
	@media (max-width: 839px) {
		.footer { justify-content: center; gap: var(--space-3); padding-inline: var(--gutter-mobile); }
		.footer__sep { display: none; }
	}
</style>
