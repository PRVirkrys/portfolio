---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Tag from '../components/ui/Tag.astro';
import NextCase from '../components/case/NextCase.astro';
import CaseLightbox from '../components/case/CaseLightbox.astro';
import CaseConfidentialityNote from '../components/case/CaseConfidentialityNote.astro';
import CaseExecutiveSummary from '../components/case/CaseExecutiveSummary.astro';
import { Clock, ExternalLink } from '@lucide/astro';
import type { TagCategory } from '../data/work-navigation';
import { withBase } from '../lib/url';
import { getWorkCompany, companyWorkPath } from '../data/work-companies';

type Props = CollectionEntry<'blog'>['data'] & { readingMinutes?: number };

const {
	title,
	description,
	heroImage,
	tags,
	breadcrumbs: authoredBreadcrumbs,
	company,
	customer,
	client,
	industry,
	role,
	location,
	date,
	liveUrl,
	collaboration,
	tools,
	platform,
	caseLayout = 'default',
	executiveSummary,
	nextCase,
	confidentialityNote,
	readingMinutes,
} = Astro.props;

const workCompany = getWorkCompany(company);
const breadcrumbs = workCompany ? [
	{ label: 'Work', href: '/work/' },
	{ label: workCompany.name, href: companyWorkPath(workCompany.id) },
	{ label: customer ?? title, href: undefined },
] : authoredBreadcrumbs?.map((crumb, index) => index === 0 ? { label: 'Work', href: '/work/' } : crumb);

// Figma's metadata table (node 16071:69160) orders "Sitio en vivo" before
// "Colaboración" — Colaboración is the last row, so it's the one that loses
// its border-bottom, not the live-link row. Rendered separately below so
// that order holds regardless of which optional fields are present.
const metaRows = [
	{ label: 'Contexto / cliente', value: client },
	{ label: 'Industria', value: industry },
	{ label: 'Mi rol', value: role },
	{ label: 'Ubicación', value: location },
	{ label: 'Fecha', value: date },
].filter((row): row is { label: string; value: string } => Boolean(row.value));
---

<html lang="es" class="dark">
	<head>
		<BaseHead title={title} description={description} />
	</head>
	<body>
		<Header />
		<div class="cs-page" data-case-layout={caseLayout === 'editorial' ? 'editorial' : undefined}>

			{breadcrumbs && breadcrumbs.length > 0 && (
				<nav class="cs-hero__breadcrumbs" aria-label="Breadcrumb">
					{breadcrumbs.map((crumb, i) => (
						<>
							{i > 0 && <span class="cs-crumb__sep" aria-hidden="true">/</span>}
							{crumb.href
								? <a class="cs-crumb" href={withBase(crumb.href)} data-work-return={i === 0 ? '' : undefined}>{crumb.label}</a>
								: <span aria-current={i === breadcrumbs.length - 1 ? 'page' : undefined} class:list={['cs-crumb', { 'cs-crumb--active': i === breadcrumbs.length - 1 }]}>{crumb.label}</span>
							}
						</>
					))}
				</nav>
			)}

			<!-- Hero -------------------------------------------------- -->
			<!-- Figma node 16071:69150 uses a centered 1288×707 image with the
			     content panel pulled upward so it overlaps the lower portion of
			     the image instead of starting strictly below it. -->
			<div class="cs-hero">
				{heroImage && (
					<div class="cs-hero__image-wrap">
						<div class="cs-hero__image-frame">
							<Image
								src={heroImage}
								alt=""
								class="cs-hero__image"
							/>
						</div>
					</div>
				)}

				<div class="cs-hero__content">
					<div class="cs-hero__content-inner">
						<div class="cs-hero__text">
							{tags && tags.length > 0 && (
								<div class="cs-hero__tags">
									{tags.map(t => (
										<Tag category={t.category as TagCategory}>{t.label}</Tag>
									))}
								</div>
							)}
							<h1 class="cs-hero__title">{title}</h1>
							<p class="cs-hero__desc">{description}</p>
							{readingMinutes && (
								<p class="cs-hero__reading">
									<Clock class="cs-hero__reading-icon" aria-hidden="true" />
									{readingMinutes} min de lectura
								</p>
							)}
						</div>

						{(metaRows.length > 0 || liveUrl || collaboration || tools || platform) && (
							<div class="cs-hero__meta">
								{metaRows.map(row => (
									<div class="cs-meta-row">
										<span class="cs-meta-row__label">{row.label}</span>
										<span class="cs-meta-row__value">{row.value}</span>
									</div>
								))}
								{liveUrl && (
									<div class="cs-meta-row">
										<span class="cs-meta-row__label">Sitio en vivo</span>
										<a class="cs-meta-row__link" href={liveUrl.href} target="_blank" rel="noreferrer">
											{liveUrl.label}
											<ExternalLink class="cs-meta-row__ext-icon" />
										</a>
									</div>
								)}
								{collaboration && (
									<div class="cs-meta-row">
										<span class="cs-meta-row__label">Colaboración</span>
										<span class="cs-meta-row__value">{collaboration}</span>
									</div>
								)}
								{tools && (
									<div class="cs-meta-row">
										<span class="cs-meta-row__label">Herramientas</span>
										<span class="cs-meta-row__value">{tools}</span>
									</div>
								)}
								{platform && (
									<div class="cs-meta-row">
										<span class="cs-meta-row__label">Plataforma</span>
										<span class="cs-meta-row__value">{platform}</span>
									</div>
								)}
							</div>
						)}
					</div>
				</div>
			</div>

			{executiveSummary && <CaseExecutiveSummary items={executiveSummary} />}

			{confidentialityNote && <CaseConfidentialityNote />}

			<!-- Article body ------------------------------------------ -->
			<article class="cs-article">
				<slot />
			</article>

			{nextCase && <NextCase title={nextCase.title} slug={nextCase.slug} />}
		</div>
		<Footer />
		<CaseLightbox />
	</body>
</html>

<script>
	import { readWorkFilters, updateWorkQuery } from '../lib/work-filters';
	const returnLink = document.querySelector<HTMLAnchorElement>('[data-work-return]');
	const from = new URLSearchParams(location.search).get('from');
	if (returnLink && from) {
		const filters = readWorkFilters(from);
		returnLink.href = `${new URL(returnLink.href).pathname}${updateWorkQuery('', filters)}`;
	}
</script>

<style>
	/* Page wrapper — sidebar offset comes from body padding in global.css */
	.cs-page {
		width: 100%;
		padding-top: var(--component-header-height-desktop);
		display: flex;
		flex-direction: column;
		min-height: 100vh;
	}

	/* ── Breadcrumbs ──────────────────────────────────────────────────── */
	/* Normal flow now (not an overlay), so it just sits in the page's own
	   stacking — no absolute positioning, no header-height math to double
	   count. */
	.cs-hero__breadcrumbs {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: calc(12px * var(--ui-scale));
		padding: calc(32px * var(--ui-scale)) calc(64px * var(--ui-scale)) 0;
		font-family: var(--font-sans);
		font-size: calc(14px * var(--ui-scale));
		font-weight: 500;
		letter-spacing: calc(7px * var(--ui-scale));
		text-transform: uppercase;
	}
	.cs-crumb {
		color: color-mix(in srgb, var(--color-text) 90%, transparent);
		text-decoration: none;
	}
	.cs-crumb--active {
		color: var(--sidebar-item-text-active);
	}
	.cs-crumb__sep {
		color: color-mix(in srgb, var(--color-text) 90%, transparent);
	}

	/* ── Hero ─────────────────────────────────────────────────────────── */
	/* Figma node 16071:69150 centers a 1288×707 hero image inside a 1616px
	   frame, then lifts the content panel upward so it overlaps the bottom
	   270px of the image. */
	.cs-hero {
		display: flex;
		flex-direction: column;
	}
	.cs-hero__image-wrap {
		display: flex;
		justify-content: center;
		padding: calc(32px * var(--ui-scale)) calc(64px * var(--ui-scale));
		padding-bottom: 0;
	}
	.cs-hero__image-frame {
		width: min(calc(1288px * var(--ui-scale)), 100%);
		/* Matches the delivered hero assets' native ratio (3386×1616), not the
		   old Figma placeholder's 1288×707 — that mismatch left `object-fit:
		   contain` letterboxing blank bars above/below the image on every
		   case study. */
		aspect-ratio: 3386 / 1616;
		overflow: hidden;
		border-radius: var(--radius-md);
	}
	.cs-hero__image {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: contain;
		object-position: center;
		border-radius: 0;
	}

	/* ── Hero content ─────────────────────────────────────────────────── */
	.cs-hero__content {
		/* -270px was calibrated for the old 707px-tall frame (38.2% overlap).
		   Scaled down to match the shorter real-asset frame height so the
		   same proportion of the image stays visible behind the card. */
		margin-top: calc(-235px * var(--ui-scale));
		background: var(--color-bg);
		border-top: var(--border-width) solid var(--color-border);
		position: relative;
		z-index: 1;
	}
	.cs-hero__content-inner {
		box-sizing: border-box;
		display: flex;
		align-items: center;
		gap: calc(24px * var(--ui-scale));
		width: 100%;
		max-width: calc(1440px * var(--ui-scale));
		margin-inline: auto;
		padding: calc(64px * var(--ui-scale));
	}
	.cs-hero__text {
		display: flex;
		flex-direction: column;
		gap: calc(25px * var(--ui-scale));
		flex: 0 0 min(calc(732px * var(--ui-scale)), 48%);
		overflow: hidden;
	}
	.cs-hero__tags {
		display: flex;
		flex-wrap: wrap;
		gap: calc(10px * var(--ui-scale));
	}
	.cs-hero__title {
		font-family: var(--font-heading);
		font-size: calc(64px * var(--ui-scale));
		font-weight: 700;
		line-height: 1.2;
		letter-spacing: -0.5px;
		color: var(--color-text);
		margin: 0;
	}
	.cs-hero__desc {
		font-family: var(--font-sans);
		font-size: calc(20px * var(--ui-scale));
		font-weight: 400;
		line-height: 1.75;
		letter-spacing: calc(1px * var(--ui-scale));
		color: color-mix(in srgb, var(--color-text) 90%, transparent);
		margin: 0;
	}

	/* Same eyebrow voice as the meta-table labels: secondary info, not content. */
	.cs-hero__reading {
		display: inline-flex;
		align-items: center;
		gap: calc(8px * var(--ui-scale));
		margin: 0;
		font-family: var(--font-sans);
		font-size: calc(12px * var(--ui-scale));
		font-weight: 800;
		line-height: 1.75;
		letter-spacing: calc(6px * var(--ui-scale));
		text-transform: uppercase;
		color: color-mix(in srgb, var(--color-text) 80%, transparent);
	}
	.cs-hero__reading-icon {
		width: calc(16px * var(--ui-scale));
		height: calc(16px * var(--ui-scale));
		flex-shrink: 0;
	}

	/* ── Meta table ───────────────────────────────────────────────────── */
	/* Figma's "metadata table" (node 16071:69160) pads the row stack away
	   from the card's own border (24px sides / 32px top+bottom) instead of
	   running rows edge-to-edge — the last row still has no border-bottom
	   (see :last-child below), so that padding is what closes it off instead
	   of a line. */
	.cs-hero__meta {
		flex: 1;
		min-width: 0;
		background: var(--color-bg-subtle); /* #1a1a33 dark / #e8e8eb light */
		border: var(--border-width) solid var(--color-border);
		padding: calc(32px * var(--ui-scale)) calc(24px * var(--ui-scale));
		display: flex;
		flex-direction: column;
	}
	.cs-meta-row {
		display: flex;
		align-items: center;
		gap: calc(12px * var(--ui-scale));
		padding: calc(24px * var(--ui-scale));
		border-bottom: var(--border-width) solid var(--color-border);
	}
	.cs-meta-row:last-child {
		border-bottom: none;
	}
	.cs-meta-row__label {
		flex: 0 0 calc(190px * var(--ui-scale));
		font-family: var(--font-sans);
		font-size: calc(12px * var(--ui-scale));
		font-weight: 800;
		line-height: 1.75;
		letter-spacing: calc(6px * var(--ui-scale));
		text-transform: uppercase;
		color: color-mix(in srgb, var(--color-text) 80%, transparent);
	}
	.cs-meta-row__value {
		flex: 1;
		font-family: var(--font-sans);
		font-size: calc(14px * var(--ui-scale));
		font-weight: 600;
		line-height: 1.75;
		letter-spacing: calc(1px * var(--ui-scale));
		color: color-mix(in srgb, var(--color-text) 90%, transparent);
	}
	.cs-meta-row__link {
		display: inline-flex;
		align-items: center;
		gap: calc(8px * var(--ui-scale));
		font-family: var(--font-sans);
		font-size: calc(14px * var(--ui-scale));
		font-weight: 600;
		letter-spacing: calc(1px * var(--ui-scale));
		color: color-mix(in srgb, var(--color-text) 90%, transparent);
		text-decoration: underline;
	}
	.cs-meta-row__link:hover {
		color: var(--color-action-ghost-text);
	}
	.cs-meta-row__ext-icon {
		width: calc(18px * var(--ui-scale));
		height: calc(18px * var(--ui-scale));
		flex-shrink: 0;
	}

	/* ── Article ──────────────────────────────────────────────────────── */
	.cs-article {
		display: flex;
		flex-direction: column;
		flex: 1;
	}

	/* ── Editorial case-study variant ───────────────────────────────────
	   Opt-in only. The content and the existing case components remain the
	   source of truth; this layer changes composition and reading rhythm. */
	.cs-page[data-case-layout='editorial'] .cs-hero {
		border-bottom: var(--border-width) solid var(--color-border);
	}
	.cs-page[data-case-layout='editorial'] .cs-hero__content {
		order: -1;
		margin-top: 0;
		border-top: 0;
	}
	.cs-page[data-case-layout='editorial'] .cs-hero__content-inner {
		align-items: flex-start;
		gap: calc(80px * var(--ui-scale));
		padding-block: calc(96px * var(--ui-scale)) calc(72px * var(--ui-scale));
	}
	.cs-page[data-case-layout='editorial'] .cs-hero__text {
		flex: 1 1 calc(820px * var(--ui-scale));
		max-width: calc(860px * var(--ui-scale));
		overflow: visible;
	}
	.cs-page[data-case-layout='editorial'] .cs-hero__title {
		max-width: 18ch;
		font-size: clamp(calc(48px * var(--ui-scale)), 5vw, calc(82px * var(--ui-scale)));
		line-height: 1.02;
		letter-spacing: -0.045em;
	}
	.cs-page[data-case-layout='editorial'] .cs-hero__desc {
		max-width: 64ch;
		font-size: calc(22px * var(--ui-scale));
		line-height: 1.6;
	}
	.cs-page[data-case-layout='editorial'] .cs-hero__meta {
		flex: 0 1 calc(420px * var(--ui-scale));
		width: 100%;
		padding: 0;
		background: transparent;
		border: 0;
		border-top: var(--border-width) solid var(--color-border);
	}
	.cs-page[data-case-layout='editorial'] .cs-meta-row {
		align-items: flex-start;
		padding: calc(18px * var(--ui-scale)) 0;
	}
	.cs-page[data-case-layout='editorial'] .cs-meta-row__label {
		flex-basis: calc(150px * var(--ui-scale));
		letter-spacing: calc(4px * var(--ui-scale));
	}
	.cs-page[data-case-layout='editorial'] .cs-hero__image-wrap {
		padding: 0 calc(64px * var(--ui-scale)) calc(96px * var(--ui-scale));
	}
	.cs-page[data-case-layout='editorial'] .cs-hero__image-frame {
		width: min(calc(1440px * var(--ui-scale)), 100%);
		border-radius: var(--radius-md);
	}

	.cs-page[data-case-layout='editorial'] .cs-article {
		counter-reset: case-section;
	}
	.cs-page[data-case-layout='editorial'] :global(.cs-section) {
		counter-increment: case-section;
		padding-block: calc(152px * var(--ui-scale));
	}
	.cs-page[data-case-layout='editorial'] :global(.cs-section__inner) {
		position: relative;
		max-width: calc(1440px * var(--ui-scale));
	}
	.cs-page[data-case-layout='editorial'] :global(.cs-section__header::before) {
		content: counter(case-section, decimal-leading-zero);
		font-family: var(--font-heading);
		font-size: calc(72px * var(--ui-scale));
		font-weight: 700;
		line-height: 0.85;
		letter-spacing: -0.05em;
		color: var(--color-action-ghost-text);
	}
	.cs-page[data-case-layout='editorial'] :global(.cs-section__heading) {
		max-width: 17ch;
		font-size: clamp(calc(38px * var(--ui-scale)), 3.5vw, calc(56px * var(--ui-scale)));
		line-height: 1.08;
		letter-spacing: -0.035em;
	}

	/* Every section follows the same pattern on desktop: the chapter header
	   (number, tag, heading) owns a left column and stays sticky while its
	   section scrolls; all copy and media flow in the right column. The copy
	   wrapper becomes display: contents so its header and body children join
	   the section grid directly — the MDX and component markup stay as-is.
	   The header spans many implicit rows (empty ones collapse to 0 with
	   row-gap 0), so its height never stretches the first content row; as a
	   sticky grid item it travels within the whole section and rests at the
	   section's bottom when it ends. */
	@media (min-width: 961px) {
		.cs-page[data-case-layout='editorial'] :global(.cs-section[data-layout] .cs-section__inner) {
			display: grid;
			grid-template-columns: minmax(0, 4fr) minmax(0, 8fr);
			column-gap: calc(96px * var(--ui-scale));
			row-gap: 0;
			align-items: start;
		}
		.cs-page[data-case-layout='editorial'] :global(.cs-section[data-layout] .cs-section__copy) {
			display: contents;
		}
		.cs-page[data-case-layout='editorial'] :global(.cs-section[data-layout] .cs-section__header) {
			grid-column: 1;
			grid-row: 1 / span 99;
			position: sticky;
			top: calc(var(--component-header-height-desktop) + 32px * var(--ui-scale));
			margin-bottom: 0;
		}
		.cs-page[data-case-layout='editorial'] :global(.cs-section[data-layout] .cs-section__copy > :not(.cs-section__header)),
		.cs-page[data-case-layout='editorial'] :global(.cs-section[data-layout] .cs-section__assets) {
			grid-column: 2;
			width: 100%;
			max-width: calc(820px * var(--ui-scale));
		}
		.cs-page[data-case-layout='editorial'] :global(.cs-section[data-layout] .cs-section__assets) {
			max-width: none;
			margin: 0 0 calc(64px * var(--ui-scale));
		}
		/* Side layout's absolutely positioned cover image depends on a flex
		   row sibling for its height; in the grid it sizes itself. */
		.cs-page[data-case-layout='editorial'] :global(.cs-section[data-layout='side'] .cs-section__assets > img) {
			position: static;
			height: auto;
			border-radius: var(--radius-md);
		}
		.cs-page[data-case-layout='editorial'] :global(.cs-section__copy > .cs-image-row) {
			max-width: none;
			margin-block: calc(56px * var(--ui-scale));
		}
		.cs-page[data-case-layout='editorial'] :global(.cs-section__heading) {
			max-width: none;
			font-size: clamp(calc(34px * var(--ui-scale)), 2.6vw, calc(46px * var(--ui-scale)));
		}
	}
	.cs-page[data-case-layout='editorial'] :global(.cs-image-row:has(> :only-child) img) {
		width: 100%;
		max-height: none;
	}

	@media (max-width: 1100px) {
		.cs-page[data-case-layout='editorial'] .cs-hero__content-inner {
			gap: calc(56px * var(--ui-scale));
		}
		.cs-page[data-case-layout='editorial'] .cs-hero__meta {
			flex-basis: auto;
		}
	}

	/* ── Responsive ───────────────────────────────────────────────────── */
	@media (max-width: 1100px) {
		.cs-hero__content-inner {
			flex-direction: column;
		}
		.cs-hero__content { margin-top: calc(-156px * var(--ui-scale)); }
		.cs-hero__text {
			flex: unset;
			width: 100%;
		}
		.cs-hero__meta {
			width: 100%;
		}
		.cs-hero__title {
			font-size: calc(44px * var(--ui-scale));
		}
	}
	@media (max-width: 839px) {
		.cs-page {
			padding-top: var(--component-header-height-mobile);
		}
		.cs-hero__image-wrap {
			padding: var(--gutter-mobile);
			padding-bottom: calc(48px * var(--ui-scale));
		}
		.cs-hero__content {
			margin-top: calc(-63px * var(--ui-scale));
		}
		.cs-hero__content-inner {
			padding: var(--gutter-mobile);
		}
		.cs-hero__title {
			font-size: calc(32px * var(--ui-scale));
		}
		.cs-hero__desc {
			/* Match the desktop size (calc(20px * scale) = 16px real) instead
			   of shrinking the hero description on mobile. */
			font-size: calc(20px * var(--ui-scale));
		}
		.cs-hero__breadcrumbs {
			padding: var(--gutter-mobile) var(--gutter-mobile) 0;
			font-size: calc(11px * var(--ui-scale));
		}
		.cs-meta-row__label {
			flex: 0 0 120px;
			font-size: calc(10px * var(--ui-scale));
		}
		.cs-page[data-case-layout='editorial'] .cs-hero__content {
			margin-top: 0;
		}
		.cs-page[data-case-layout='editorial'] .cs-hero__content-inner {
			padding-block: calc(64px * var(--ui-scale));
		}
		.cs-page[data-case-layout='editorial'] .cs-hero__title {
			font-size: calc(42px * var(--ui-scale));
		}
		.cs-page[data-case-layout='editorial'] .cs-hero__image-wrap {
			padding: 0 var(--gutter-mobile) calc(64px * var(--ui-scale));
		}
		.cs-page[data-case-layout='editorial'] :global(.cs-section) {
			padding-block: calc(96px * var(--ui-scale));
		}
