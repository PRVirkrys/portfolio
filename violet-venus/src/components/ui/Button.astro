---
// Figma: PR Brand (DS) → UI kit → Button (node 15629:62)
// Primary keeps the Legacy/Button-primary-01 gradient border; hover, pressed,
// and focus use the reversed gradient orientation (see gradient tokens).
export interface Props {
	variant?: 'primary' | 'secondary' | 'ghost';
	size?: 'md' | 'lg';
	href?: string;
	type?: 'button' | 'submit' | 'reset';
	disabled?: boolean;
	class?: string;
}

const {
	variant = 'primary',
	size = 'md',
	href,
	type = 'button',
	disabled = false,
	class: className,
	...rest
} = Astro.props;

const hasLeadingIcon = Astro.slots.has('icon-leading');
const hasTrailingIcon = Astro.slots.has('icon-trailing');
const Tag = href ? 'a' : 'button';
---

<Tag
	class:list={['button', className]}
	data-variant={variant}
	data-size={size}
	href={!disabled ? href : undefined}
	type={!href ? type : undefined}
	disabled={!href && disabled ? true : undefined}
	aria-disabled={href && disabled ? 'true' : undefined}
	tabindex={href && disabled ? -1 : undefined}
	{...rest}
>
	{
		hasLeadingIcon && (
			<span class="button__icon" aria-hidden="true">
				<slot name="icon-leading" />
			</span>
		)
	}
	<span class="button__label"><slot /></span>
	{
		hasTrailingIcon && (
			<span class="button__icon" aria-hidden="true">
				<slot name="icon-trailing" />
			</span>
		)
	}
</Tag>

<style>
	.button {
		--btn-overlay: transparent;
		--btn-surface: transparent;
		--btn-border-color: transparent;
		--btn-border-image: none;
		--btn-shadow: none;

		display: inline-flex;
		align-items: center;
		justify-content: center;
		gap: var(--space-1);
		border: var(--border-width) solid var(--btn-border-color);
		border-radius: var(--radius-sm);
		background:
			linear-gradient(var(--btn-overlay), var(--btn-overlay)) padding-box,
			linear-gradient(var(--btn-surface), var(--btn-surface)) padding-box,
			var(--btn-border-image) border-box;
		box-shadow: var(--btn-shadow);
		color: var(--button-text);
		font-family: var(--typography-ui-button-font-family);
		font-weight: var(--typography-ui-button-font-weight);
		font-size: var(--typography-ui-button-font-size);
		line-height: var(--typography-ui-button-line-height);
		letter-spacing: var(--typography-ui-button-letter-spacing);
		text-decoration: none;
		white-space: nowrap;
		cursor: pointer;
		transition:
			background-image var(--duration-fast) var(--ease-standard),
			box-shadow var(--duration-fast) var(--ease-standard);
	}

	.button:disabled,
	.button[aria-disabled='true'] {
		cursor: not-allowed;
		pointer-events: none;
	}

	.button__icon {
		display: inline-flex;
		flex-shrink: 0;
		width: var(--icon-sm);
		height: var(--icon-sm);
		color: var(--button-icon);
	}

	.button__icon :global(svg) {
		width: 100%;
		height: 100%;
	}

	/* Size */
	.button[data-size='md'] {
		height: var(--control-md);
		padding-inline: var(--space-6);
		padding-block: var(--space-3);
	}

	.button[data-size='lg'] {
		height: var(--control-lg);
		padding-inline: var(--space-8);
		padding-block: var(--space-4);
	}

	.button[data-variant='primary'] {
		/* Angle fed to the border gradient below. 356.7deg matches Figma's
		   static token exactly, so at rest (before any hover) this is
		   pixel-identical to --button-border-gradient-primary. The <script>
		   block below rewrites this custom property with
		   requestAnimationFrame while hovered, which is what actually spins
		   the border — see that block for why JS drives it instead of a CSS
		   @keyframes/@property animation. */
		--border-angle: 356.7deg;
		--btn-surface: var(--button-surface);
		--btn-overlay: var(--button-overlay-default);
		--btn-border-image: linear-gradient(var(--border-angle), var(--gradient-interactive-stops));
		--btn-shadow:
			var(--button-shadow-color) 0 var(--button-shadow-y) var(--button-shadow-blur) var(--button-shadow-spread);
	}

	.button[data-variant='primary']:hover {
		--btn-overlay: var(--button-overlay-hover);
	}

	.button[data-variant='primary']:focus-visible {
		--btn-overlay: var(--button-overlay-default);
		--btn-shadow: var(--elevation-button-focus);
	}

	.button[data-variant='primary']:active {
		--btn-overlay: var(--button-overlay-pressed);
		--btn-shadow: none;
	}

	.button[data-variant='primary']:disabled,
	.button[data-variant='primary'][aria-disabled='true'] {
		--btn-overlay: var(--button-overlay-pressed);
		--btn-shadow: none;
	}

	/* Secondary */
	.button[data-variant='secondary'] {
		--btn-surface: var(--button-surface);
		--btn-border-color: var(--button-border);
		--btn-shadow:
			var(--button-shadow-color) 0 var(--button-shadow-y) var(--button-shadow-blur) var(--button-shadow-spread);
	}

	.button[data-variant='secondary']:hover,
	.button[data-variant='secondary']:active,
	.button[data-variant='secondary']:disabled,
	.button[data-variant='secondary'][aria-disabled='true'] {
		--btn-overlay: var(--button-overlay-hover);
	}

	.button[data-variant='secondary']:active,
	.button[data-variant='secondary']:disabled,
	.button[data-variant='secondary'][aria-disabled='true'] {
		--btn-shadow: none;
	}

	.button[data-variant='secondary']:focus-visible {
		--btn-overlay: transparent;
		--btn-shadow: var(--elevation-button-focus);
	}

	/* Ghost */
	.button[data-variant='ghost'] {
		--btn-shadow:
			var(--button-shadow-color) 0 var(--button-shadow-y) var(--button-shadow-blur) var(--button-shadow-spread);
	}

	.button[data-variant='ghost']:hover,
	.button[data-variant='ghost']:active,
	.button[data-variant='ghost']:disabled,
	.button[data-variant='ghost'][aria-disabled='true'] {
		--btn-surface: var(--button-surface);
		--btn-overlay: var(--button-overlay-hover);
		--btn-shadow: none;
	}

	.button[data-variant='ghost']:focus-visible {
		--btn-surface: transparent;
		--btn-overlay: transparent;
		--btn-shadow: var(--elevation-button-focus);
	}

	@media (prefers-reduced-motion: reduce) {
		.button {
			transition: none;
		}
	}
</style>

<script>
	// Rotates the primary button's border gradient continuously while
	// hovered. See gradient-motion.ts for the shared rAF driver (also used
	// by TextLink's underline) and why it's JS-driven rather than CSS.
	import { bindHoverGradientMotion, isInteractiveDisabled } from './gradient-motion';

	document.querySelectorAll<HTMLElement>('.button[data-variant="primary"]').forEach((button) => {
		bindHoverGradientMotion(button, {
			property: '--border-angle',
			unit: 'deg',
			speed: 120, // one full turn every 3s, matches the previous spin
			wrapAt: 360,
			initialValue: 356.7, // mirrors the --border-angle default set in CSS
			isDisabled: isInteractiveDisabled,
		});
	});
</script>
